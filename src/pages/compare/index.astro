---
import Layout from '../../layouts/Layout.astro';
import { availabilityLabels, availabilityNotes, capabilityDefinition, displayOptionalPackagePrices, displayVehicleFactStatus, displayVehiclePrice, displayVehicleReferenceTotal, handsOffLabels, levelLabels, monitoringLabels, officialLinkFor, vehicleDecisionFingerprint, vehicleDecisionSignals, vehicleFactoryShippingEstimate, vehicleReferenceLabel, vehicles } from '../../data/loader';

const availabilityPublicKeys: Record<string, string> = {
  new_order_available: 'order',
  inventory_only: 'stock',
  used_only: 'used',
  service_available: 'service',
  trial_or_research: 'trial',
  announced: 'future',
  unavailable: 'closed',
  unknown: 'uncertain',
};
const handsOffPublicKeys: Record<string, string> = { allowed_in_conditions: 'conditional', not_allowed: 'hands_on', unknown: 'uncertain' };
const monitoringPublicKeys: Record<string, string> = { required: 'monitor', takeover_ready: 'ready', not_required_in_odd: 'not_needed', unknown: 'uncertain' };
const publicAvailabilityLabels = Object.fromEntries(Object.entries(availabilityLabels).map(([key, label]) => [availabilityPublicKeys[key], label]));
const publicAvailabilityNotes = Object.fromEntries(Object.entries(availabilityNotes).map(([key, note]) => [availabilityPublicKeys[key], note]));
const publicHandsOffLabels = Object.fromEntries(Object.entries(handsOffLabels).map(([key, label]) => [handsOffPublicKeys[key], label]));
const publicMonitoringLabels = Object.fromEntries(Object.entries(monitoringLabels).map(([key, label]) => [monitoringPublicKeys[key], label]));
const publicCatalog = vehicles.map((vehicle) => ({
  id: vehicle.id,
  maker: vehicle.maker,
  model: vehicle.model,
  grade: vehicle.grade,
  automationLevel: vehicle.automationLevel,
  requiredPackage: vehicle.requiredPackage,
  availability: availabilityPublicKeys[vehicle.availability],
  handsOff: handsOffPublicKeys[vehicle.handsOff],
  driverMonitoring: monitoringPublicKeys[vehicle.driverMonitoring],
  odd: vehicle.odd,
  capabilities: vehicle.capabilities.map((id) => capabilityDefinition(id).label),
  referenceLabel: vehicleReferenceLabel(vehicle),
  priceLabel: displayVehiclePrice(vehicle),
  optionalPackageLabel: displayOptionalPackagePrices(vehicle),
  referenceTotalLabel: displayVehicleReferenceTotal(vehicle),
  shippingEstimateLabel: vehicleFactoryShippingEstimate(vehicle),
  freshnessLabel: displayVehicleFactStatus(vehicle),
  decisionFingerprint: vehicleDecisionFingerprint(vehicle),
  decisionSignals: vehicleDecisionSignals(vehicle),
  officialLink: (() => {
    const link = officialLinkFor(vehicle);
    return link ? { url: link.url, kind: link.kind, actions: link.actions?.map(({ kind, label, url }) => ({ kind, label, url })) } : undefined;
  })(),
}));
---
<Layout title="2〜3台を比較する｜自動運転.jp" description="自動運転レベルと作動条件、必要装備を2〜3台で比較できます。">
  <section class="page-intro"><div class="wrap"><div class="eyebrow">COMPARE CONDITIONS</div><h1>2〜3台の違いを、同じ軸で。</h1><p class="hero-copy">レベルの数字だけでなく、道路・速度・監視・ハンズオフ・必要装備を並べます。同じ項目は最初から畳み、未確認は優劣にせず表示します。</p></div></section>
  <section class="section" style="padding-top: 10px;"><div class="wrap">
    <form class="compare-select" method="get" action="/compare/" data-compare-select>
      {vehicles.map((vehicle) => <label class="check-card"><input type="checkbox" name="ids" value={vehicle.id} /> <span><strong>{vehicle.maker} {vehicle.model}</strong><br /><small class="subtle">Level {vehicle.automationLevel} · {vehicleReferenceLabel(vehicle)} · {vehicle.grade}</small></span></label>)}
      <div style="grid-column: 1 / -1; display:flex; justify-content:flex-end;"><button class="button alt" type="submit">選択した車両を比較</button></div>
    </form>
    <div class="compare-change" data-compare-change-wrap hidden><button class="button small text" type="button" data-compare-change>比較する車両を変更</button></div>
    <div class="compare-result-actions"><button class="button small text" type="button" data-save-compare hidden>この比較を保存</button><span class="subtle" data-save-compare-note aria-live="polite"></span></div>
    <div class="empty" data-compare-empty><h2>比較する車両を一覧から選んでください。</h2><p>車両一覧の「比較に追加」から2〜3台を選ぶと、条件を横並びで確認できます。</p><a class="button text" href="/">車を探す</a></div>
    <div data-compare-result hidden></div>
  </div></section>
  <script define:vars={{ catalog: publicCatalog, levelLabels, availabilityLabels: publicAvailabilityLabels, availabilityNotes: publicAvailabilityNotes, handsOffLabels: publicHandsOffLabels, monitoringLabels: publicMonitoringLabels }}>
    // @ts-nocheck
    const escapeHtml = (value) => String(value ?? '不明').replace(/[&<>"']/g, (char) => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[char]));
    const fact = (value) => Array.isArray(value) ? value.join(' / ') || '不明' : value || '不明';
    let compareTracked = false;
    let compareCompleteTracked = false;
    const sendCompare = (selected) => {
      if (compareTracked) return;
      const payload = { vehicle_ids: selected.map((vehicle) => vehicle.id).join(','), vehicle_count: selected.length };
      if (window.jidouuntenTrack) window.jidouuntenTrack('compare_vehicles', payload);
      else { window.__jidouuntenPendingEvents = window.__jidouuntenPendingEvents || []; window.__jidouuntenPendingEvents.push({ event: 'compare_vehicles', payload }); }
      compareTracked = true;
    };
    const sendCompareComplete = (selected, diffCount) => {
      if (compareCompleteTracked) return;
      const payload = { vehicle_ids: selected.map((vehicle) => vehicle.id).join(','), vehicle_count: selected.length, diff_count: diffCount, completion_definition: 'comparison_result_rendered' };
      if (window.jidouuntenTrack) window.jidouuntenTrack('compare_complete', payload);
      else { window.__jidouuntenPendingEvents = window.__jidouuntenPendingEvents || []; window.__jidouuntenPendingEvents.push({ event: 'compare_complete', payload }); }
      compareCompleteTracked = true;
    };
    const renderCompare = () => {
      const params = new URLSearchParams(location.search);
      const ids = [...new Set(params.getAll('ids'))].slice(0, 3);
      const selected = ids.map((id) => catalog.find((vehicle) => vehicle.id === id)).filter(Boolean);
      const checkboxes = [...document.querySelectorAll('input[name="ids"]')];
      checkboxes.forEach((input) => { input.checked = ids.includes(input.value); });
      checkboxes.forEach((input) => { input.disabled = !input.checked && ids.length >= 3; input.addEventListener('change', () => { const checked = checkboxes.filter((item) => item.checked).length; checkboxes.forEach((item) => { item.disabled = !item.checked && checked >= 3; }); }); });
      const empty = document.querySelector('[data-compare-empty]'); const result = document.querySelector('[data-compare-result]');
      if (!empty || !result) return;
      const selectForm = document.querySelector('[data-compare-select]');
      const changeWrap = document.querySelector('[data-compare-change-wrap]');
      const saveButton = document.querySelector('[data-save-compare]');
      if (saveButton) saveButton.hidden = selected.length < 2;
      if (selectForm) selectForm.hidden = selected.length >= 2;
      if (changeWrap) changeWrap.hidden = selected.length < 2;
      empty.hidden = selected.length >= 2; result.hidden = selected.length < 2;
      if (selected.length < 2) return;
      const headings = selected.map((v) => `<th>${escapeHtml(v.maker)} ${escapeHtml(v.model)}</th>`).join('');
      const cells = (fn) => selected.map((v) => `<td>${fn(v)}</td>`).join('');
    const normalize = (value) => String(value ?? '不明')
        .replace(/高速道路の本線/g, '高速道路')
        .replace(/自動車専用道路の本線/g, '自動車専用道路')
        .replace(/[\s　]/g, '');
    const isUnknown = (value) => {
        const text = String(value ?? '').trim();
      return !text || text === '不明' || text.includes('不明') || text.includes('未確認') || text === '価格要確認' || text === '公式価格未確認' || text === '標準装備 / 不明' || text.includes('算出不可');
    };
    const uncertainState = 'unconfirmed';
    const stateFor = (values) => {
        if (values.some(isUnknown)) return uncertainState;
        return new Set(values.map(normalize)).size > 1 ? 'diff' : 'same';
      };
      const row = (label, valueFn, key, noteFn) => {
        const values = selected.map(valueFn);
        const state = stateFor(values);
        const note = noteFn ? noteFn : () => '';
        const marker = state === 'diff' ? '<span class="compare-diff-badge">差分</span>' : '';
        return `<tr class="compare-row compare-row-${state}" data-compare-row="${key}"><th>${label}${marker}</th>${selected.map((v, index) => `<td>${escapeHtml(values[index])}${note(v)}</td>`).join('')}</tr>`;
      };
      const capabilityLabels = [...new Set(selected.flatMap((v) => v.capabilities))].sort((a, b) => a.localeCompare(b, 'ja'));
      const capabilityRows = capabilityLabels.map((label) => {
        const allConfirmed = selected.every((v) => v.capabilities.includes(label));
        const state = allConfirmed ? 'same' : uncertainState;
        return `<tr class="compare-row compare-row-${state}" data-compare-row="capability-${escapeHtml(label)}"><th>確認できた機能<small>${escapeHtml(label)}</small></th>${selected.map((v) => `<td>${v.capabilities.includes(label) ? '<strong>確認済み</strong>' : '未確認'}</td>`).join('')}</tr>`;
      }).join('');
      const optionalPackageRows = selected.some((v) => v.optionalPackageLabel)
        ? row('追加パッケージ<small>車両本体価格とは別</small>', (v) => v.optionalPackageLabel || '追加価格は未確認', 'optional-package')
        : '';
      const referenceTotalRows = selected.some((v) => v.referenceTotalLabel)
        ? row('参考総額<small>本体＋確認済み追加パッケージ</small>', (v) => v.referenceTotalLabel || '算出不可（本体価格または追加価格を合算できません）', 'reference-total')
        : '';
      const freshnessRows = selected.some((v) => v.freshnessLabel)
        ? row('情報状態', (v) => v.freshnessLabel || '確認済み', 'fact-status')
        : '';
      const actionLinks = (v, kinds, buttonClass) => {
        const actions = (v.officialLink?.actions || []).filter((action) => kinds.includes(action.kind));
        return actions.length ? `<div class="purchase-action-list">${actions.map((action) => `<a class="button small ${buttonClass}" href="${escapeHtml(action.url)}" target="_blank" rel="noopener noreferrer" data-purchase-action data-action-type="${escapeHtml(action.kind)}" data-vehicle-id="${escapeHtml(v.id)}" data-manufacturer="${escapeHtml(v.maker)}">${escapeHtml(action.label)} ↗</a>`).join('')}</div>` : '次アクション未確認';
      };
      const comparisonRows = [
        row('参考価格<small>車両本体の公式掲載価格</small>', (v) => v.priceLabel, 'price'),
        optionalPackageRows,
        referenceTotalRows,
        freshnessRows,
        row('工場出荷目処<small>モデル単位の目安</small>', (v) => v.shippingEstimateLabel || '未確認', 'factory-shipping'),
        row('自動化レベル', (v) => `Level ${v.automationLevel} · ${levelLabels[v.automationLevel]}`, 'level'),
        row('道路', (v) => fact(v.odd.roadTypes), 'road'),
        row('速度', (v) => v.odd.speedKph?.condition || (v.odd.speedKph?.max ? `${v.odd.speedKph.min ?? 0}〜${v.odd.speedKph.max}km/h` : '不明'), 'speed'),
        row('ハンズオフ', (v) => handsOffLabels[v.handsOff], 'hands-off'),
        row('運転者監視', (v) => monitoringLabels[v.driverMonitoring], 'driver-monitoring'),
        row('必要パッケージ', (v) => v.requiredPackage || '不明', 'required-package'),
        row('販売・利用状態', (v) => availabilityLabels[v.availability], 'availability', (v) => availabilityNotes[v.availability] ? `<small>${escapeHtml(availabilityNotes[v.availability])}</small>` : ''),
        `<tr class="compare-row compare-row-${uncertainState}" data-compare-row="official"><th>公式サイト<small>最新仕様を確認</small></th>${selected.map((v) => `<td>${v.officialLink ? `<a class="button small text" href="${escapeHtml(v.officialLink.url)}" target="_blank" rel="noopener noreferrer" data-official-link data-vehicle-id="${escapeHtml(v.id)}" data-manufacturer="${escapeHtml(v.maker)}" data-link-kind="${escapeHtml(v.officialLink.kind)}">${v.officialLink.kind === 'archive' ? '過去資料を開く' : '公式サイトを開く'} ↗</a>` : 'リンク未確認'}</td>`).join('')}</tr>`,
        `<tr class="compare-row compare-row-${uncertainState}" data-compare-row="purchase-actions"><th>公式の購入・試乗<small>注文・試乗</small></th>${selected.map((v) => `<td>${actionLinks(v, ['order', 'test_drive'], 'alt')}</td>`).join('')}</tr>`,
        `<tr class="compare-row compare-row-${uncertainState}" data-compare-row="consideration-actions"><th>公式の検討用導線<small>見積り・販売店・カタログ</small></th>${selected.map((v) => `<td>${actionLinks(v, ['estimate', 'dealer', 'catalog'], 'text')}<small>注文できることを示すリンクではありません。</small></td>`).join('')}</tr>`,
      ].join('');
      const diffCount = [
        selected.map((v) => v.priceLabel),
        selected.map((v) => v.optionalPackageLabel || '追加価格は未確認'),
        selected.map((v) => v.referenceTotalLabel || '参考総額は算出不可'),
        selected.map((v) => v.freshnessLabel || '確認済み'),
        selected.map((v) => v.shippingEstimateLabel || '未確認'),
        selected.map((v) => `Level ${v.automationLevel} · ${levelLabels[v.automationLevel]}`),
        selected.map((v) => fact(v.odd.roadTypes)),
        selected.map((v) => v.odd.speedKph?.condition || (v.odd.speedKph?.max ? `${v.odd.speedKph.min ?? 0}〜${v.odd.speedKph.max}km/h` : '不明')),
        selected.map((v) => handsOffLabels[v.handsOff]),
        selected.map((v) => monitoringLabels[v.driverMonitoring]),
        selected.map((v) => v.requiredPackage || '不明'),
        selected.map((v) => availabilityLabels[v.availability]),
      ].filter((values) => stateFor(values) === 'diff').length;
      result.innerHTML = `<div class="compare-diff-summary"><strong data-compare-diff-count="${diffCount}">確認済みの差分 ${diffCount}項目</strong><span>「未確認」は優劣ではなく、根拠不足の表示です。</span><button type="button" class="button small text" data-toggle-same>すべての項目を表示</button><button type="button" class="button small text" data-compare-print>印刷</button><button type="button" class="button small text" data-compare-copy>比較をコピー</button><span class="compare-export-note" data-compare-export-note role="status" aria-live="polite"></span></div><div class="cards" style="margin-bottom:28px;">${selected.map((v) => `<article class="vehicle-card"><div class="vehicle-card-body"><div class="eyebrow">LEVEL ${v.automationLevel} · ${escapeHtml(levelLabels[v.automationLevel])}</div><h3>${escapeHtml(v.maker)} ${escapeHtml(v.model)}</h3><div class="maker">${escapeHtml(v.referenceLabel)}　${escapeHtml(v.grade)}</div></div></article>`).join('')}</div><div style="overflow-x:auto;"><table class="compare-table" data-hide-same="true"><thead><tr><th>比較項目</th>${headings}</tr></thead><tbody>${comparisonRows}${capabilityRows}</tbody></table></div>`;
      result.querySelector('[data-toggle-same]')?.addEventListener('click', (event) => {
        const table = result.querySelector('.compare-table');
        if (!table) return;
        const hideSame = table.dataset.hideSame !== 'true';
        table.dataset.hideSame = String(hideSame);
        event.currentTarget.textContent = hideSame ? 'すべての項目を表示' : '同じ項目を隠す';
      });
      const briefText = [
        '自動運転.jp 比較ブリーフ',
        selected.map((v) => `${v.maker} ${v.model} ${v.grade}｜Level ${v.automationLevel}・${levelLabels[v.automationLevel]}`).join('\n'),
        '',
        ...selected.map((v) => [
          `${v.maker} ${v.model} ${v.grade}`,
          `参考価格: ${v.priceLabel}`,
          `道路: ${fact(v.odd.roadTypes)}`,
          `速度: ${v.odd.speedKph?.condition || (v.odd.speedKph?.max ? `${v.odd.speedKph.min ?? 0}〜${v.odd.speedKph.max}km/h` : '不明')}`,
          `ハンズオフ: ${handsOffLabels[v.handsOff]}`,
          `運転者監視: ${monitoringLabels[v.driverMonitoring]}`,
          `公式: ${v.officialLink?.url || 'リンク未確認'}`,
        ].join('\n')).join('\n\n'),
        '',
        `比較URL: ${location.href}`,
        '「未確認」は優劣ではなく、根拠不足の表示です。最新仕様はメーカー公式で確認してください。',
      ].join('\n');
      const exportNote = result.querySelector('[data-compare-export-note]');
      const trackExport = (kind) => window.jidouuntenTrack?.('compare_export', { vehicle_count: selected.length, export_type: kind });
      result.querySelector('[data-compare-print]')?.addEventListener('click', () => {
        trackExport('print');
        window.print();
      });
      result.querySelector('[data-compare-copy]')?.addEventListener('click', async (event) => {
        let copied = false;
        try {
          if (navigator.clipboard?.writeText) { await navigator.clipboard.writeText(briefText); copied = true; }
        } catch { /* fall back to a local textarea for browsers without clipboard permission */ }
        if (!copied) {
          const textarea = document.createElement('textarea');
          textarea.value = briefText; textarea.setAttribute('readonly', ''); textarea.style.position = 'fixed'; textarea.style.opacity = '0';
          document.body.appendChild(textarea); textarea.select(); copied = document.execCommand('copy'); textarea.remove();
        }
        if (copied) {
          trackExport('copy');
          if (exportNote) exportNote.textContent = '比較をコピーしました';
          window.setTimeout(() => { if (exportNote) exportNote.textContent = ''; }, 1800);
        } else if (exportNote) exportNote.textContent = 'コピーできませんでした。印刷をお試しください';
      });
      result.querySelectorAll('[data-official-link]').forEach((link) => link.addEventListener('click', () => {
        const url = new URL(link.href);
        window.jidouuntenTrack?.('outbound_manufacturer', { vehicle_id: link.dataset.vehicleId, manufacturer: link.dataset.manufacturer, link_url: link.href, link_domain: url.hostname, link_type: link.dataset.linkKind, placement: 'comparison' });
      }));
      result.querySelectorAll('[data-purchase-action]').forEach((link) => link.addEventListener('click', () => {
        const url = new URL(link.href);
        window.jidouuntenTrack?.('outbound_purchase_action', { vehicle_id: link.dataset.vehicleId, manufacturer: link.dataset.manufacturer, action_type: link.dataset.actionType, link_url: link.href, link_domain: url.hostname, placement: 'comparison' });
      }));
      sendCompare(selected);
      sendCompareComplete(selected, diffCount);
    };
    document.querySelector('[data-save-compare]')?.addEventListener('click', (event) => {
      const params = new URLSearchParams(location.search);
      const ids = [...new Set(params.getAll('ids'))].slice(0, 3);
      if (ids.length < 2) return;
      const selected = ids.map((id) => catalog.find((vehicle) => vehicle.id === id)).filter(Boolean);
      if (selected.length < 2) return;
      const button = event.currentTarget;
      const label = selected.map((vehicle) => `${vehicle.maker} ${vehicle.model}`).join(' × ');
      const href = `/compare/?${ids.map((id) => `ids=${encodeURIComponent(id)}`).join('&')}`;
      const snapshot = { entries: selected.map((vehicle) => ({ id: vehicle.id, fingerprint: vehicle.decisionFingerprint, signals: vehicle.decisionSignals })) };
      if (window.jidouuntenSave?.('compare', href, label, snapshot)) {
        const note = document.querySelector('[data-save-compare-note]');
        if (note) note.textContent = '比較を保存しました';
        button.textContent = '保存しました';
        window.setTimeout(() => { button.textContent = 'この比較を保存'; if (note) note.textContent = ''; }, 1800);
      }
    });
    document.querySelector('[data-compare-change]')?.addEventListener('click', () => {
      const selectForm = document.querySelector('[data-compare-select]');
      const changeWrap = document.querySelector('[data-compare-change-wrap]');
      if (selectForm) selectForm.hidden = false;
      if (changeWrap) changeWrap.hidden = true;
      selectForm?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
    window.addEventListener('popstate', renderCompare); renderCompare();
  </script>
</Layout>
