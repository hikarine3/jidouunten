---
import Layout from '../../layouts/Layout.astro';
import { availabilityLabels, availabilityNotes, displayVehiclePrice, handsOffLabels, levelLabels, monitoringLabels, officialLinkFor, vehicleReferenceLabel, vehicles } from '../../data/loader';

const publicCatalog = vehicles.map((vehicle) => ({
  id: vehicle.id,
  maker: vehicle.maker,
  model: vehicle.model,
  grade: vehicle.grade,
  automationLevel: vehicle.automationLevel,
  requiredPackage: vehicle.requiredPackage,
  availability: vehicle.availability,
  handsOff: vehicle.handsOff,
  driverMonitoring: vehicle.driverMonitoring,
  odd: vehicle.odd,
  referenceLabel: vehicleReferenceLabel(vehicle),
  priceLabel: displayVehiclePrice(vehicle),
  officialLink: (() => {
    const link = officialLinkFor(vehicle);
    return link ? { url: link.url, kind: link.kind } : undefined;
  })(),
}));
---
<Layout title="2台を比較する｜自動運転.jp" description="自動運転レベルと作動条件、必要装備を2台で比較できます。">
  <section class="page-intro"><div class="wrap"><div class="eyebrow">COMPARE CONDITIONS</div><h1>2台の違いを、同じ軸で。</h1><p class="hero-copy">レベルの数字だけでなく、道路・速度・監視・ハンズオフ・必要装備を並べます。不明な項目は「不明」と表示します。</p></div></section>
  <section class="section" style="padding-top: 10px;"><div class="wrap">
    <form class="compare-select" method="get" action="/compare/">
      {vehicles.map((vehicle) => <label class="check-card"><input type="checkbox" name="ids" value={vehicle.id} /> <span><strong>{vehicle.maker} {vehicle.model}</strong><br /><small class="subtle">Level {vehicle.automationLevel} · {vehicleReferenceLabel(vehicle)} · {vehicle.grade}</small></span></label>)}
      <div style="grid-column: 1 / -1; display:flex; justify-content:flex-end;"><button class="button alt" type="submit">選択した車両を比較</button></div>
    </form>
    <div class="empty" data-compare-empty><h2>比較する車両を一覧から選んでください。</h2><p>車両一覧の「比較に追加」から2台を選ぶと、条件を横並びで確認できます。</p><a class="button text" href="/">車を探す</a></div>
    <div data-compare-result hidden></div>
  </div></section>
  <script define:vars={{ catalog: publicCatalog, levelLabels, availabilityLabels, availabilityNotes, handsOffLabels, monitoringLabels }}>
    // @ts-nocheck
    const escapeHtml = (value) => String(value ?? '不明').replace(/[&<>"']/g, (char) => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[char]));
    const fact = (value) => Array.isArray(value) ? value.join(' / ') || '不明' : value || '不明';
    let compareTracked = false;
    const sendCompare = (selected) => {
      if (compareTracked) return;
      const payload = { vehicle_ids: selected.map((vehicle) => vehicle.id).join(','), vehicle_count: selected.length };
      if (window.jidouuntenTrack) window.jidouuntenTrack('compare_vehicles', payload);
      else { window.__jidouuntenPendingEvents = window.__jidouuntenPendingEvents || []; window.__jidouuntenPendingEvents.push({ event: 'compare_vehicles', payload }); }
      compareTracked = true;
    };
    const renderCompare = () => {
      const params = new URLSearchParams(location.search);
      const ids = [...new Set(params.getAll('ids'))].slice(0, 2);
      const selected = ids.map((id) => catalog.find((vehicle) => vehicle.id === id)).filter(Boolean);
      const checkboxes = [...document.querySelectorAll('input[name="ids"]')];
      checkboxes.forEach((input) => { input.checked = ids.includes(input.value); });
      checkboxes.forEach((input) => { input.disabled = !input.checked && ids.length >= 2; input.addEventListener('change', () => { const checked = checkboxes.filter((item) => item.checked).length; checkboxes.forEach((item) => { item.disabled = !item.checked && checked >= 2; }); }); });
      const empty = document.querySelector('[data-compare-empty]'); const result = document.querySelector('[data-compare-result]');
      if (!empty || !result) return;
      empty.hidden = selected.length === 2; result.hidden = selected.length !== 2;
      if (selected.length !== 2) return;
      const headings = selected.map((v) => `<th>${escapeHtml(v.maker)} ${escapeHtml(v.model)}</th>`).join('');
      const cells = (fn) => selected.map((v) => `<td>${fn(v)}</td>`).join('');
      result.innerHTML = `<div class="cards" style="margin-bottom:28px;">${selected.map((v) => `<article class="vehicle-card"><div class="vehicle-card-body"><div class="eyebrow">LEVEL ${v.automationLevel} · ${escapeHtml(levelLabels[v.automationLevel])}</div><h3>${escapeHtml(v.maker)} ${escapeHtml(v.model)}</h3><div class="maker">${escapeHtml(v.referenceLabel)}　${escapeHtml(v.grade)}</div></div></article>`).join('')}</div><div style="overflow-x:auto;"><table class="compare-table"><thead><tr><th>比較項目</th>${headings}</tr></thead><tbody><tr><th>参考価格<small>車両本体の公式掲載価格</small></th>${cells((v) => escapeHtml(v.priceLabel))}</tr><tr><th>自動化レベル</th>${cells((v) => `<strong>Level ${v.automationLevel}</strong><br />${escapeHtml(levelLabels[v.automationLevel])}`)}</tr><tr><th>道路</th>${cells((v) => escapeHtml(fact(v.odd.roadTypes)))}</tr><tr><th>速度</th>${cells((v) => escapeHtml(v.odd.speedKph?.condition || (v.odd.speedKph?.max ? `${v.odd.speedKph.min ?? 0}〜${v.odd.speedKph.max}km/h` : '不明')))}</tr><tr><th>ハンズオフ</th>${cells((v) => escapeHtml(handsOffLabels[v.handsOff]))}</tr><tr><th>運転者監視</th>${cells((v) => escapeHtml(monitoringLabels[v.driverMonitoring]))}</tr><tr><th>必要パッケージ</th>${cells((v) => escapeHtml(v.requiredPackage || '不明'))}</tr><tr><th>販売・利用状態</th>${cells((v) => `${escapeHtml(availabilityLabels[v.availability])}${availabilityNotes[v.availability] ? `<small>${escapeHtml(availabilityNotes[v.availability])}</small>` : ''}`)}</tr><tr><th>公式サイト<small>最新仕様を確認</small></th>${cells((v) => v.officialLink ? `<a class="button small text" href="${escapeHtml(v.officialLink.url)}" target="_blank" rel="noopener noreferrer" data-official-link data-vehicle-id="${escapeHtml(v.id)}" data-manufacturer="${escapeHtml(v.maker)}" data-link-kind="${escapeHtml(v.officialLink.kind)}">${v.officialLink.kind === 'archive' ? '過去資料を開く' : '公式サイトを開く'} ↗</a>` : 'リンク未確認')}</tr></tbody></table></div>`;
      result.querySelectorAll('[data-official-link]').forEach((link) => link.addEventListener('click', () => {
        const url = new URL(link.href);
        window.jidouuntenTrack?.('outbound_manufacturer', { vehicle_id: link.dataset.vehicleId, manufacturer: link.dataset.manufacturer, link_url: link.href, link_domain: url.hostname, link_type: link.dataset.linkKind, placement: 'comparison' });
      }));
      sendCompare(selected);
    };
    window.addEventListener('popstate', renderCompare); renderCompare();
  </script>
</Layout>
