---
import Layout from '../../layouts/Layout.astro';
import VehicleList from '../../components/VehicleList.astro';
import { isDefaultListedVehicle, vehicles } from '../../data/loader';
const currentVehicleCount = vehicles.filter(isDefaultListedVehicle).length;
---
<Layout title="自動運転・Level 1/2車種一覧｜機能・価格で比較｜自動運転.jp" description={`日本で選べる自動運転・Level 1/2運転支援車${currentVehicleCount}販売単位を、自動化レベル、機能、メーカー、価格、発売・導入時期から探して比較できます。`}>
  <VehicleList action="/cars/" />
</Layout>
