---
import Layout from '../../layouts/Layout.astro';
import VehicleCard from '../../components/VehicleCard.astro';
import { availabilityLabels, canonicalRoadType, handsOffLabels, roadFilterLabels, vehicles } from '../../data/loader';
const roads = [...new Set(vehicles.flatMap((v) => v.odd.roadTypes.map(canonicalRoadType)))].sort();
const roadOptions = roads.length ? roads : [...roadFilterLabels];
const defaultCount = vehicles.filter((v) => v.availability === 'new_order_available' || (v.availability === 'unknown' && v.currentCatalogListed === true)).length;
---
<Layout title="車を探す｜自動運転.jp" description="自動運転レベル、道路、ハンズオフ、販売状態から日本の車両を絞り込みます。">
  <section class="page-intro"><div class="wrap"><div class="eyebrow">FIND YOUR NEXT CAR</div><h1>条件から、候補を絞り込む。</h1><p class="hero-copy">表示されるのは、車両データに根拠がある販売単位です。既定では現行カタログ掲載を確認した候補を表示し、受注状況が不明な車両は明示します。</p></div></section>
  <section class="section" style="padding-top: 10px;"><div class="wrap">
    <form class="filters" method="get" action="/cars/" id="vehicle-filters">
      <div class="filter-grid">
        <label>自動化レベル<select name="level"><option value="">すべて</option>{[1,2,3,4,5].map((item) => <option value={item}>Level {item}</option>)}</select></label>
        <label>主な道路<select name="road"><option value="">すべて</option>{roadOptions.map((item) => <option value={item}>{item}</option>)}</select></label>
        <label>ハンズオフ<select name="handsOff"><option value="">すべて</option>{Object.entries(handsOffLabels).map(([key, label]) => <option value={key}>{label}</option>)}</select></label>
        <label>販売・利用状態<select name="availability"><option value="">カタログ掲載確認（既定）</option><option value="all">すべての状態</option>{Object.entries(availabilityLabels).map(([key, label]) => <option value={key}>{label}</option>)}</select></label>
      </div>
      <div style="display:flex; justify-content:flex-end; margin-top:14px;"><button class="button alt" type="submit">この条件で探す</button></div>
    </form>
    <div class="notice" data-level2-notice hidden><strong>Level 2：常時監視が必要です。</strong><br />ハンズオフ可能な条件があっても、運転者は周囲を監視し、いつでも引き継げる状態を保ちます。</div>
    <div class="results-bar"><h2 style="margin:0; font-size:1.55rem;"><span data-selected-label>カタログ掲載確認</span> <span class="subtle" data-result-count>{defaultCount}件</span></h2><span class="subtle">URLに条件を保存できます</span></div>
    <div class="cards" data-results>{vehicles.map((vehicle) => <div data-vehicle-shell hidden={vehicle.availability !== 'new_order_available' && !(vehicle.availability === 'unknown' && vehicle.currentCatalogListed === true)} data-level={vehicle.automationLevel} data-road={vehicle.odd.roadTypes.map(canonicalRoadType).join('|')} data-hands-off={vehicle.handsOff} data-availability={vehicle.availability} data-current-catalog={String(vehicle.currentCatalogListed === true)}><VehicleCard vehicle={vehicle} /></div>)}</div>
    <div class="empty" data-empty hidden><h2>条件に合う候補はまだありません</h2><p>販売状態を「すべて」にするか、道路・ハンズオフの条件をゆるめてお試しください。データ未登録の場合もこの表示になります。</p><a class="button text" href="/cars/">条件をリセット</a></div>
  </div></section>
  <script>
    // @ts-nocheck
    const form = document.querySelector('#vehicle-filters');
    const shells = [...document.querySelectorAll('[data-vehicle-shell]')];
    let lastTrackedSearch = '';
    const applyFilters = (trackInteraction = false) => {
      const params = new URLSearchParams(location.search);
      const level = params.get('level') || '';
      const road = params.get('road') || '';
      const handsOff = params.get('handsOff') || '';
      const availability = params.get('availability') || '';
      form?.querySelectorAll('select').forEach((select) => { select.value = params.get(select.name) || ''; });
      let count = 0;
      shells.forEach((shell) => {
        const defaultAvailable = shell.dataset.availability === 'new_order_available' || (shell.dataset.availability === 'unknown' && shell.dataset.currentCatalog === 'true');
        const show = (!level || shell.dataset.level === level) && (!road || (shell.dataset.road || '').split('|').includes(road)) && (!handsOff || shell.dataset.handsOff === handsOff) && (availability && availability !== 'all' ? shell.dataset.availability === availability : availability === 'all' ? true : defaultAvailable);
        shell.hidden = !show; if (show) count += 1;
      });
      const label = document.querySelector('[data-selected-label]'); if (label) label.textContent = level ? `Level ${level}` : 'カタログ掲載確認';
      const resultCount = document.querySelector('[data-result-count]'); if (resultCount) resultCount.textContent = `${count}件`;
      const empty = document.querySelector('[data-empty]'); if (empty) empty.hidden = count !== 0;
      const notice = document.querySelector('[data-level2-notice]'); if (notice) notice.hidden = level !== '2';
      if (trackInteraction && location.search !== lastTrackedSearch) { window.jidouuntenTrack?.('filter_results', { filter_name: 'vehicle_filters', filter_value: `${level || 'all'}|${road || 'all'}|${handsOff || 'all'}|${availability || 'default'}`, result_count: count }); lastTrackedSearch = location.search; }
    };
    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      const query = new URLSearchParams(new FormData(form));
      [...query.entries()].forEach(([key, value]) => { if (!value) query.delete(key); });
      history.pushState({}, '', `${form.action}${query.toString() ? `?${query.toString()}` : ''}`);
      applyFilters(true);
    });
    window.addEventListener('popstate', () => applyFilters(false)); applyFilters(false);
  </script>
</Layout>
