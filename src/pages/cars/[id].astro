---
import Layout from '../../layouts/Layout.astro';
import { availabilityLabels, availabilityNotes, capabilityDefinition, displayCatalogAsOf, displayIntroducedAt, displayOptionalPackagePrices, displayVehicleFactStatus, displayVehiclePrice, displayVehicleReferenceTotal, handsOffLabels, levelCaveat, levelLabels, listFact, monitoringLabels, officialLinkFor, vehicleFactoryShippingEstimate, vehicleImageFor, vehicleReferenceLabel, vehicleStructuredData, vehicles } from '../../data/loader';
export function getStaticPaths() { return vehicles.map((vehicle) => ({ params: { id: vehicle.id }, props: { vehicle } })); }
const { vehicle } = Astro.props;
if (!vehicle) throw new Error('Vehicle not found');
const odd = vehicle.odd;
const officialLink = officialLinkFor(vehicle);
const shippingEstimate = vehicleFactoryShippingEstimate(vehicle);
const image = vehicleImageFor(vehicle);
const optionalPackageLabel = displayOptionalPackagePrices(vehicle);
const referenceTotalLabel = displayVehicleReferenceTotal(vehicle);
const factStatusLabel = displayVehicleFactStatus(vehicle);
const officialActions = officialLink?.actions ?? [];
const purchaseActions = officialActions.filter(({ kind }) => kind === 'order' || kind === 'test_drive');
const considerationActions = officialActions.filter(({ kind }) => kind === 'estimate' || kind === 'dealer' || kind === 'catalog');
const testDriveActions = officialActions.filter(({ kind }) => kind === 'test_drive');
const detailCanonical = `https://jidouunten.jp/cars/${vehicle.id}/`;
const capabilitySummary = vehicle.capabilities.map((item) => capabilityDefinition(item).label).slice(0, 3).join('・');
const detailTitle = `${vehicle.maker} ${vehicle.model} ${vehicle.grade}｜Level ${vehicle.automationLevel}・価格・機能｜自動運転.jp`;
const detailDescription = `${vehicle.maker} ${vehicle.model} ${vehicle.grade}のLevel ${vehicle.automationLevel}運転支援。${displayVehiclePrice(vehicle)}、${capabilitySummary || '主な運転支援機能'}、${handsOffLabels[vehicle.handsOff]}を確認できます。`;
const productStructuredData: Record<string, unknown> = {
  '@type': 'Product',
  '@id': `${detailCanonical}#product`,
  name: `${vehicle.maker} ${vehicle.model} ${vehicle.grade}`,
  description: detailDescription,
  brand: { '@type': 'Brand', name: vehicle.maker },
  category: '自動運転・運転支援車',
  additionalProperty: [
    { '@type': 'PropertyValue', name: '自動化レベル', value: `Level ${vehicle.automationLevel}` },
    { '@type': 'PropertyValue', name: 'ハンズオフ', value: handsOffLabels[vehicle.handsOff] },
    { '@type': 'PropertyValue', name: '運転者の監視', value: monitoringLabels[vehicle.driverMonitoring] },
  ],
};
const detailPrice = vehicle.price?.amounts[0]?.amountJpy;
if (detailPrice) productStructuredData.offers = { '@type': 'Offer', price: detailPrice, priceCurrency: 'JPY', url: detailCanonical };
const breadcrumbs = [
  { name: '自動運転.jp', url: 'https://jidouunten.jp/' },
  { name: '車両一覧', url: 'https://jidouunten.jp/cars/' },
  { name: `${vehicle.maker} ${vehicle.model}`, url: detailCanonical },
  { name: vehicle.grade, url: detailCanonical },
];
const publicClassificationRationale = (value: string) => value
  .replaceAll('handsOff=not_allowed', 'ハンズオフは不可')
  .replaceAll('handsOff=allowed_in_conditions', 'ハンズオフは条件内で可')
  .replaceAll('handsOff=unknown', 'ハンズオフは未確認')
  .replaceAll('not_allowed', '不可')
  .replaceAll('allowed_in_conditions', '条件内で可')
  .replaceAll('unknown', '未確認');
const oddSpeed = odd.speedKph?.condition || (odd.speedKph?.max ? `${odd.speedKph.min ?? 0}〜${odd.speedKph.max}km/h` : '公式情報で確認');
const checklistItems = [
  { key: 'road', label: '道路', value: listFact(odd.roadTypes) },
  { key: 'speed', label: '速度', value: oddSpeed },
  { key: 'monitoring', label: '運転者の監視', value: monitoringLabels[vehicle.driverMonitoring] },
  { key: 'hands-off', label: 'ハンドル保持', value: handsOffLabels[vehicle.handsOff] },
  { key: 'handover', label: '引継ぎ・停止／再開', value: odd.driverConditions?.length ? listFact(odd.driverConditions) : '公式情報で確認' },
];
---
<Layout title={detailTitle} description={detailDescription} structuredData={[productStructuredData, vehicleStructuredData(vehicle)]} breadcrumbs={breadcrumbs}>
  <section class="page-intro"><div class="wrap"><a class="subtle" href="/">← 車両一覧へ戻る</a></div></section>
  <section class="section" style="padding-top: 0;"><div class="wrap detail-grid">
    <aside class="detail-hero"><div class="eyebrow">{vehicle.market} / {vehicleReferenceLabel(vehicle)}</div>{image && <figure class="detail-image"><img src={image.src} width={image.width} height={image.height} sizes="(max-width: 850px) 100vw, 40vw" decoding="async" fetchpriority="high" alt={image.alt} /><figcaption><a href={image.sourceUrl} target="_blank" rel="noopener noreferrer">写真：Wikimedia Commons</a> / <a href={image.authorUrl} target="_blank" rel="noopener noreferrer">{image.author}</a> · <a href={image.licenseUrl} target="_blank" rel="noopener noreferrer">{image.license}</a><small>{image.note}</small></figcaption></figure>}<div class="level-num">{vehicle.automationLevel}</div><div class="eyebrow" style="color:white;">{levelLabels[vehicle.automationLevel]}</div><h1>{vehicle.maker}<br />{vehicle.model}</h1><p>{vehicle.grade}</p><span class:list={['pill', vehicle.availability === 'new_order_available' && 'lime']}>{availabilityLabels[vehicle.availability]}</span><button class="button small text favorite-toggle" type="button" data-favorite-toggle data-vehicle-id={vehicle.id} aria-pressed="false">お気に入りに追加</button><p style="margin:18px 0 0; color:#d5e1e2; font-size:.84rem;">{levelCaveat(vehicle.automationLevel)}</p></aside>
    <div>
      <section class="detail-section"><h2>まず確認したいこと</h2><dl class="fact-grid"><div class="fact"><dt>参考価格</dt><dd>{displayVehiclePrice(vehicle)}<small>車両本体の公式掲載価格。諸費用・オプションは別です。</small></dd></div>{optionalPackageLabel && <div class="fact"><dt>追加パッケージ</dt><dd>{optionalPackageLabel}<small>車両本体価格とは別。設定・適用条件は公式で確認してください。</small></dd></div>}{referenceTotalLabel && <div class="fact"><dt>参考総額</dt><dd>{referenceTotalLabel}<small>車両本体＋確認済み追加パッケージ。諸費用・他オプションは含みません。</small></dd></div>}<div class="fact"><dt>必要パッケージ</dt><dd>{vehicle.requiredPackage || '標準装備 / 不明'}</dd></div><div class="fact"><dt>ハンズオフ</dt><dd>{handsOffLabels[vehicle.handsOff]}</dd></div><div class="fact"><dt>運転者の監視</dt><dd>{monitoringLabels[vehicle.driverMonitoring]}</dd></div><div class="fact"><dt>販売・利用状態</dt><dd>{availabilityLabels[vehicle.availability]}{availabilityNotes[vehicle.availability] && <small>{availabilityNotes[vehicle.availability]}</small>}</dd></div>{shippingEstimate && <div class="fact"><dt>工場出荷目処</dt><dd>{shippingEstimate}<small>メーカーのモデル単位の目安です。一部仕様・グレードや販売店の状況で変わるため、個別の注文可否・納車時期は販売店で確認してください。</small></dd></div>}{factStatusLabel && <div class="fact fact-status-detail"><dt>情報状態</dt><dd>{factStatusLabel}<small>販売状態は90日、機能・作動条件は180日を目安に再確認します。最新情報はメーカー公式で確認してください。</small></dd></div>}{vehicle.salesUnitIntroducedAt ? <div class="fact"><dt>発売・導入時期</dt><dd>{displayIntroducedAt(vehicle.salesUnitIntroducedAt).replace('発売・導入 ', '')}</dd></div> : vehicle.catalogAsOf ? <div class="fact"><dt>現行カタログ確認</dt><dd>{displayCatalogAsOf(vehicle.catalogAsOf)}</dd></div> : null}</dl></section>
      <section class="detail-section"><h2>作動条件（ODD）</h2><dl class="fact-grid"><div class="fact"><dt>道路</dt><dd>{listFact(odd.roadTypes)}</dd></div><div class="fact"><dt>速度</dt><dd>{odd.speedKph?.condition || (odd.speedKph?.max ? `${odd.speedKph.min ?? 0}〜${odd.speedKph.max}km/h` : '不明')}</dd></div><div class="fact"><dt>交通条件</dt><dd>{listFact(odd.trafficConditions)}</dd></div><div class="fact"><dt>天候</dt><dd>{listFact(odd.weather)}</dd></div><div class="fact"><dt>地理条件</dt><dd>{listFact(odd.geoRestriction)}</dd></div><div class="fact"><dt>運転者条件</dt><dd>{listFact(odd.driverConditions)}</dd></div></dl><p style="margin:16px 0 0;">{odd.manufacturerSummary || '作動条件の公式要約は不明です。'}</p></section>
      <section class="detail-section"><h2>できること / 注意点</h2><h3>確認できた機能</h3><ul class="detail-list capability-detail-list">{vehicle.capabilities?.length ? vehicle.capabilities.map((item) => <li><strong>{capabilityDefinition(item).label}</strong><span>{capabilityDefinition(item).description}</span></li>) : <li>未確認</li>}</ul><h3>制限</h3><ul class="detail-list">{vehicle.limitations?.length ? vehicle.limitations.map((item) => <li>{item}</li>) : <li>不明</li>}</ul></section>
      <section class="detail-section adas-checklist" data-adas-checklist data-vehicle-id={vehicle.id}>
        <div class="checklist-heading"><div><p class="eyebrow">試乗前の準備</p><h2>運転支援の確認リスト</h2><p>試乗や公式情報の確認前に、作動条件を5項目で整理できます。チェックは安全性や操作の保証ではありません。</p></div><span class="checklist-progress" data-checklist-progress>0 / {checklistItems.length} 確認</span></div>
        <div class="checklist-items">
          {checklistItems.map((item) => <label class="checklist-item"><input type="checkbox" data-checklist-item={item.key} /><span><strong>{item.label}</strong><small>{item.value}</small></span></label>)}
        </div>
        <p class="checklist-complete" data-checklist-complete hidden>確認完了。試乗では必ずメーカー担当者の案内に従ってください。</p>
        {testDriveActions.length ? <div class="checklist-next"><span>確認後に公式の試乗情報へ</span>{testDriveActions.map((action) => <a class="button small alt" href={action.url} target="_blank" rel="noopener noreferrer" data-checklist-action data-action-type={action.kind} data-placement="vehicle_detail_checklist" data-vehicle-id={vehicle.id} data-manufacturer={vehicle.maker}>{action.label} <span aria-hidden="true">↗</span></a>)}</div> : <p class="subtle">この販売単位の試乗導線は未確認です。メーカー公式ページで確認してください。</p>}
      </section>
      {officialLink && <section class="detail-section official-next"><div><p class="eyebrow">NEXT STEP</p><h2>{officialLink.kind === 'archive' ? 'メーカー公式の過去資料で確認' : 'メーカー公式サイトで仕様を確認'}</h2><p>{officialLink.kind === 'archive' ? 'この車両は現在利用不可です。現行車の見積・注文ページではなく、当時の公式資料へ移動します。' : vehicle.availability === 'new_order_available' ? 'メーカー公式サイトから、最新仕様・購入条件・納期を確認してください。注文後の在庫・納車時期やソフトウェア条件は個別に異なります。' : '購入判断の前に、最新の仕様・注意事項をメーカー公式サイトで確認してください。新車注文できることを示すリンクではありません。'}</p></div><a class="button alt" href={officialLink.url} target="_blank" rel="noopener noreferrer" data-official-link data-vehicle-id={vehicle.id} data-manufacturer={vehicle.maker} data-link-kind={officialLink.kind}>公式サイトを開く <span aria-hidden="true">↗</span></a></section>}
      {officialActions.length ? <section class="detail-section purchase-actions"><div><p class="eyebrow">次のアクション</p><h2>公式の検討・購入導線</h2><p>販売単位の比較後に選べる、メーカー公式の手続きです。見積り・販売店検索・カタログは検討用で、注文できることを示しません。</p></div>{purchaseActions.length ? <div><h3>購入・試乗</h3><div class="purchase-action-list">{purchaseActions.map((action) => <a class="button alt" href={action.url} target="_blank" rel="noopener noreferrer" data-purchase-action data-action-type={action.kind} data-vehicle-id={vehicle.id} data-manufacturer={vehicle.maker}>{action.label} <span aria-hidden="true">↗</span></a>)}</div></div> : null}{considerationActions.length ? <div><h3>検討用</h3><div class="purchase-action-list">{considerationActions.map((action) => <a class="button small text" href={action.url} target="_blank" rel="noopener noreferrer" data-purchase-action data-action-type={action.kind} data-vehicle-id={vehicle.id} data-manufacturer={vehicle.maker}>{action.label} <span aria-hidden="true">↗</span></a>)}</div></div> : null}</section> : null}
      {vehicle.classificationRationale && <section class="detail-section"><h2>このレベルの分類根拠</h2><p>{publicClassificationRationale(vehicle.classificationRationale)}</p><p class="subtle">このサイトの分類は、メーカーの機能説明と国土交通省などの定義を照合した表示です。メーカーによる「Level {vehicle.automationLevel}認証」や安全性の保証を意味しません。</p></section>}
    </div>
  </div></section>
  <script define:vars={{ vehicleId: vehicle.id, modelYear: vehicle.modelYear ?? '', grade: vehicle.grade }}>
    // @ts-nocheck
    const viewPayload = { vehicle_id: vehicleId, model_year: modelYear, grade };
    const sendView = () => {
      if (window.jidouuntenTrack) window.jidouuntenTrack('view_vehicle', viewPayload);
      else { window.__jidouuntenPendingEvents = window.__jidouuntenPendingEvents || []; window.__jidouuntenPendingEvents.push({ event: 'view_vehicle', payload: viewPayload }); }
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', sendView, { once: true }); else sendView();
    document.querySelector('[data-official-link]')?.addEventListener('click', (event) => {
      const link = event.currentTarget;
      const url = new URL(link.href);
      window.jidouuntenTrack?.('outbound_manufacturer', { vehicle_id: link.dataset.vehicleId, manufacturer: link.dataset.manufacturer, link_url: link.href, link_domain: url.hostname, link_type: link.dataset.linkKind, placement: 'vehicle_detail' });
    });
    const checklist = document.querySelector('[data-adas-checklist]');
    const checklistItems = [...(checklist?.querySelectorAll('[data-checklist-item]') || [])];
    let checklistOpened = false;
    let checklistCompleted = false;
    const updateChecklist = () => {
      const checked = checklistItems.filter((item) => item.checked).length;
      const progress = checklist?.querySelector('[data-checklist-progress]');
      if (progress) progress.textContent = `${checked} / ${checklistItems.length} 確認`;
      if (checked === checklistItems.length && !checklistCompleted) {
        checklistCompleted = true;
        checklist?.querySelector('[data-checklist-complete]')?.removeAttribute('hidden');
        window.jidouuntenTrack?.('adas_checklist_complete', { vehicle_id: vehicleId, item_count: checklistItems.length });
      }
    };
    checklistItems.forEach((item) => item.addEventListener('change', () => {
      if (!checklistOpened) {
        checklistOpened = true;
        window.jidouuntenTrack?.('adas_checklist_open', { vehicle_id: vehicleId, item_count: checklistItems.length });
      }
      updateChecklist();
    }));
    checklist?.querySelector('h2')?.addEventListener('click', () => {
      if (!checklistOpened) {
        checklistOpened = true;
        window.jidouuntenTrack?.('adas_checklist_open', { vehicle_id: vehicleId, item_count: checklistItems.length });
      }
    });
    document.querySelectorAll('[data-purchase-action], [data-checklist-action]').forEach((link) => link.addEventListener('click', () => {
      const url = new URL(link.href);
      window.jidouuntenTrack?.('outbound_purchase_action', { vehicle_id: link.dataset.vehicleId, manufacturer: link.dataset.manufacturer, action_type: link.dataset.actionType, link_url: link.href, link_domain: url.hostname, placement: link.dataset.placement || 'vehicle_detail' });
    }));
  </script>
</Layout>
