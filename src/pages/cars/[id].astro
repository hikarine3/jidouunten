---
import Layout from '../../layouts/Layout.astro';
import { availabilityLabels, availabilityNotes, capabilityDefinition, displayIntroducedAt, displayOptionalPackagePrices, displayVehiclePrice, handsOffLabels, levelCaveat, levelLabels, listFact, monitoringLabels, officialLinkFor, vehicleReferenceLabel, vehicles } from '../../data/loader';
export function getStaticPaths() { return vehicles.map((vehicle) => ({ params: { id: vehicle.id }, props: { vehicle } })); }
const { vehicle } = Astro.props;
if (!vehicle) throw new Error('Vehicle not found');
const odd = vehicle.odd;
const officialLink = officialLinkFor(vehicle);
const optionalPackageLabel = displayOptionalPackagePrices(vehicle);
---
<Layout title={`${vehicle.maker} ${vehicle.model}｜自動運転.jp`} description={`${vehicle.maker} ${vehicle.model}の自動化レベル、作動条件、必要装備を確認できます。`}>
  <section class="page-intro"><div class="wrap"><a class="subtle" href="/">← 車両一覧へ戻る</a></div></section>
  <section class="section" style="padding-top: 0;"><div class="wrap detail-grid">
    <aside class="detail-hero"><div class="eyebrow">{vehicle.market} / {vehicleReferenceLabel(vehicle)}</div><div class="level-num">{vehicle.automationLevel}</div><div class="eyebrow" style="color:white;">{levelLabels[vehicle.automationLevel]}</div><h1>{vehicle.maker}<br />{vehicle.model}</h1><p>{vehicle.grade}</p><span class:list={['pill', vehicle.availability === 'new_order_available' && 'lime']}>{availabilityLabels[vehicle.availability]}</span><p style="margin:18px 0 0; color:#d5e1e2; font-size:.84rem;">{levelCaveat(vehicle.automationLevel)}</p></aside>
    <div>
      <section class="detail-section"><h2>まず確認したいこと</h2><dl class="fact-grid"><div class="fact"><dt>参考価格</dt><dd>{displayVehiclePrice(vehicle)}<small>車両本体の公式掲載価格。諸費用・オプションは別です。</small></dd></div>{optionalPackageLabel && <div class="fact"><dt>追加パッケージ</dt><dd>{optionalPackageLabel}<small>車両本体価格とは別。設定・適用条件は公式で確認してください。</small></dd></div>}<div class="fact"><dt>必要パッケージ</dt><dd>{vehicle.requiredPackage || '標準装備 / 不明'}</dd></div><div class="fact"><dt>ハンズオフ</dt><dd>{handsOffLabels[vehicle.handsOff]}</dd></div><div class="fact"><dt>運転者の監視</dt><dd>{monitoringLabels[vehicle.driverMonitoring]}</dd></div><div class="fact"><dt>販売・利用状態</dt><dd>{availabilityLabels[vehicle.availability]}{availabilityNotes[vehicle.availability] && <small>{availabilityNotes[vehicle.availability]}</small>}</dd></div><div class="fact"><dt>発売・導入時期</dt><dd>{displayIntroducedAt(vehicle.salesUnitIntroducedAt).replace('発売・導入 ', '')}</dd></div></dl></section>
      <section class="detail-section"><h2>作動条件（ODD）</h2><dl class="fact-grid"><div class="fact"><dt>道路</dt><dd>{listFact(odd.roadTypes)}</dd></div><div class="fact"><dt>速度</dt><dd>{odd.speedKph?.condition || (odd.speedKph?.max ? `${odd.speedKph.min ?? 0}〜${odd.speedKph.max}km/h` : '不明')}</dd></div><div class="fact"><dt>交通条件</dt><dd>{listFact(odd.trafficConditions)}</dd></div><div class="fact"><dt>天候</dt><dd>{listFact(odd.weather)}</dd></div><div class="fact"><dt>地理条件</dt><dd>{listFact(odd.geoRestriction)}</dd></div><div class="fact"><dt>運転者条件</dt><dd>{listFact(odd.driverConditions)}</dd></div></dl><p style="margin:16px 0 0;">{odd.manufacturerSummary || '作動条件の公式要約は不明です。'}</p></section>
      <section class="detail-section"><h2>できること / 注意点</h2><h3>確認できた機能</h3><ul class="detail-list capability-detail-list">{vehicle.capabilities?.length ? vehicle.capabilities.map((item) => <li><strong>{capabilityDefinition(item).label}</strong><span>{capabilityDefinition(item).description}</span></li>) : <li>未確認</li>}</ul><h3>制限</h3><ul class="detail-list">{vehicle.limitations?.length ? vehicle.limitations.map((item) => <li>{item}</li>) : <li>不明</li>}</ul></section>
      {officialLink && <section class="detail-section official-next"><div><p class="eyebrow">NEXT STEP</p><h2>{officialLink.kind === 'archive' ? 'メーカー公式の過去資料で確認' : 'メーカー公式サイトで仕様を確認'}</h2><p>{officialLink.kind === 'archive' ? 'この車両は現在利用不可です。現行車の見積・注文ページではなく、当時の公式資料へ移動します。' : vehicle.availability === 'new_order_available' ? 'メーカー公式サイトから、最新仕様・購入条件・納期を確認してください。注文後の在庫・納車時期やソフトウェア条件は個別に異なります。' : '購入判断の前に、最新の仕様・注意事項をメーカー公式サイトで確認してください。新車注文できることを示すリンクではありません。'}</p></div><a class="button alt" href={officialLink.url} target="_blank" rel="noopener noreferrer" data-official-link data-vehicle-id={vehicle.id} data-manufacturer={vehicle.maker} data-link-kind={officialLink.kind}>公式サイトを開く <span aria-hidden="true">↗</span></a></section>}
      {vehicle.availability === 'new_order_available' && officialLink?.actions?.length ? <section class="detail-section purchase-actions"><div><p class="eyebrow">次のアクション</p><h2>公式で購入・試乗へ進む</h2><p>販売単位の比較後に選べる、メーカー公式の次の手続きです。リンク先で最新の条件を確認してください。</p></div><div class="purchase-action-list">{officialLink.actions.map((action) => <a class="button alt" href={action.url} target="_blank" rel="noopener noreferrer" data-purchase-action data-action-type={action.kind} data-vehicle-id={vehicle.id} data-manufacturer={vehicle.maker}>{action.label} <span aria-hidden="true">↗</span></a>)}</div></section> : null}
      {vehicle.classificationRationale && <section class="detail-section"><h2>このレベルの分類根拠</h2><p>{vehicle.classificationRationale}</p><p class="subtle">このサイトの分類は、メーカーの機能説明と国土交通省などの定義を照合した表示です。メーカーによる「Level {vehicle.automationLevel}認証」や安全性の保証を意味しません。</p></section>}
    </div>
  </div></section>
  <script define:vars={{ vehicleId: vehicle.id, modelYear: vehicle.modelYear ?? '', grade: vehicle.grade }}>
    // @ts-nocheck
    const viewPayload = { vehicle_id: vehicleId, model_year: modelYear, grade };
    const sendView = () => {
      if (window.jidouuntenTrack) window.jidouuntenTrack('view_vehicle', viewPayload);
      else { window.__jidouuntenPendingEvents = window.__jidouuntenPendingEvents || []; window.__jidouuntenPendingEvents.push({ event: 'view_vehicle', payload: viewPayload }); }
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', sendView, { once: true }); else sendView();
    document.querySelector('[data-official-link]')?.addEventListener('click', (event) => {
      const link = event.currentTarget;
      const url = new URL(link.href);
      window.jidouuntenTrack?.('outbound_manufacturer', { vehicle_id: link.dataset.vehicleId, manufacturer: link.dataset.manufacturer, link_url: link.href, link_domain: url.hostname, link_type: link.dataset.linkKind, placement: 'vehicle_detail' });
    });
    document.querySelectorAll('[data-purchase-action]').forEach((link) => link.addEventListener('click', () => {
      const url = new URL(link.href);
      window.jidouuntenTrack?.('outbound_purchase_action', { vehicle_id: link.dataset.vehicleId, manufacturer: link.dataset.manufacturer, action_type: link.dataset.actionType, link_url: link.href, link_domain: url.hostname, placement: 'vehicle_detail' });
    }));
  </script>
</Layout>
