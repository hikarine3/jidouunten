---
import Layout from '../layouts/Layout.astro';
import VehicleList from '../components/VehicleList.astro';
import { isDefaultListedVehicle, vehicles } from '../data/loader';
const currentVehicleCount = vehicles.filter(isDefaultListedVehicle).length;
---
<Layout title="同じLevel 2でも、できることは違う。｜自動運転.jp" description={`日本向け${currentVehicleCount}販売単位を、ハンズオフ、車線変更支援、メーカー、発売・導入時期などから探して比較できます。`}>
  <VehicleList action="/" />
</Layout>
