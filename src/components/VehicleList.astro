---
import VehicleCard from './VehicleCard.astro';
import { availabilityLabels, canonicalRoadType, capabilityDefinitions, handsOffLabels, isDefaultListedVehicle, levelIds, levelLabels, levelShort, priceBandLabels, roadFilterLabels, sortVehicleList, vehicleDecisionFingerprint, vehicleDecisionSignals, vehiclePriceMin, vehicles } from '../data/loader';

const { action = '/cars/' } = Astro.props as { action?: string };
const defaultVehicles = vehicles.filter(isDefaultListedVehicle);
const sortedVehicles = sortVehicleList(vehicles);
const defaultCount = defaultVehicles.length;
const makers = [...new Set(defaultVehicles.map((vehicle) => vehicle.maker))].sort((a, b) => a.localeCompare(b, 'ja'));
const roads = [...new Set(vehicles.flatMap((vehicle) => vehicle.odd.roadTypes.map(canonicalRoadType)))].sort();
const roadOptions = roads.length ? roads : [...roadFilterLabels];
const capabilityOptions = Object.entries(capabilityDefinitions)
  .filter(([id]) => vehicles.some((vehicle) => vehicle.capabilities.includes(id)))
  .map(([id, definition]) => ({ id, definition, count: defaultVehicles.filter((vehicle) => vehicle.capabilities.includes(id)).length }));
const priceBandOptions = Object.entries(priceBandLabels).map(([value, label]) => ({ value, label }));
const handsOffDistribution = [
  { value: 'allowed_in_conditions', label: '条件内可', count: defaultVehicles.filter((vehicle) => vehicle.handsOff === 'allowed_in_conditions').length },
  { value: 'not_allowed', label: '不可', count: defaultVehicles.filter((vehicle) => vehicle.handsOff === 'not_allowed').length },
  { value: 'unknown', label: '未確認', count: defaultVehicles.filter((vehicle) => vehicle.handsOff === 'unknown').length },
];
const laneChangeCount = defaultVehicles.filter((vehicle) => vehicle.capabilities.includes('lane_change_support')).length;
const teslaCount = defaultVehicles.filter((vehicle) => vehicle.maker === 'Tesla').length;
const levelOverview = levelIds.map((level) => {
  const listedCount = defaultVehicles.filter((vehicle) => vehicle.automationLevel === level).length;
  const totalCount = vehicles.filter((vehicle) => vehicle.automationLevel === level).length;
  const outOfScope = level === 1;
  return { level, label: levelLabels[level], description: levelShort[level], totalCount, countLabel: outOfScope ? '対象外' : listedCount ? `${listedCount}件` : totalCount ? `過去例 ${totalCount}件` : '掲載なし', availabilityShortcut: listedCount ? '' : totalCount ? 'all' : '', outOfScope };
});
const level2Vehicles = defaultVehicles.filter((vehicle) => vehicle.automationLevel === 2);
const guideProfiles = [
  { id: 'traffic-hands-off', title: '渋滞の負担を減らしたい', description: '高速道路の渋滞で、条件内ハンズオフに対応', count: level2Vehicles.filter((vehicle) => vehicle.handsOff === 'allowed_in_conditions' && vehicle.capabilities.includes('traffic_jam_assist') && vehicle.odd.roadTypes.some((road) => road.includes('高速道路'))).length, values: { level: '2', handsOff: 'allowed_in_conditions', capability: ['traffic_jam_assist'], road: '高速道路' } },
  { id: 'lane-change', title: '車線変更も支援してほしい', description: 'ウインカー操作などを前提に車線変更を支援', count: level2Vehicles.filter((vehicle) => vehicle.capabilities.includes('lane_change_support')).length, values: { level: '2', capability: ['lane_change_support'] } },
  { id: 'under-300', title: 'まずは300万円未満で探す', description: '本体価格の開始値で候補を絞る', count: level2Vehicles.filter((vehicle) => (vehicle.price?.amounts?.[0]?.amountJpy ?? Number.POSITIVE_INFINITY) < 3_000_000).length, values: { level: '2', budget: 'under_300' } },
];
---
<section class="list-top"><div class="wrap">
  <div class="catalog-command">
    <div class="catalog-command-head">
      <div><div class="eyebrow">JAPAN DRIVER ASSISTANCE FINDER</div><h1>同じLevel 2でも、<br /><strong>できることは違う。</strong></h1><p><span>日本向け<strong>{defaultCount}</strong>販売単位・<strong>{makers.length}</strong>メーカー</span><span class="catalog-subline">を、機能と条件で比較。</span></p></div>
      <button type="button" class="command-reset" data-reset-shortcut>すべての車に戻す</button>
    </div>
    <div class="level-deck">
      <div class="level-deck-head"><span><strong>掲載対象</strong> Level 2–3</span><a href="/levels/">Levelの違い ↗</a><span><strong>Level 1</strong> は対象外</span></div>
      <div class="level-rail" role="group" aria-label="自動化レベルで絞り込む">
        {levelOverview.map(({ level, label, description, totalCount, countLabel, availabilityShortcut, outOfScope }) => <button type="button" class:list={['level-shortcut', level >= 3 && 'is-automated']} data-level-shortcut={String(level)} data-availability-shortcut={availabilityShortcut} aria-label={`Level ${level} ${label}、${description}、${countLabel}${outOfScope ? '（このサイトの対象外）' : ''}`} aria-pressed="false" disabled={outOfScope || totalCount === 0}><span class="level-index">L{level}</span><strong>{label}</strong><span class="level-count">{countLabel}</span></button>)}
      </div>
      <p class="level-scope-note">この車両一覧は、前後と左右を同時に支援するLevel 2と、確認できたLevel 3を比較対象にしています。Level 1（前後または左右の片側支援）は本カタログの対象外です。Level 4・5は現在掲載がありません。</p>
    </div>
    <div class="capability-deck">
      <div class="capability-title"><span>L2のハンズオフ</span><small>運転者の常時監視が必要</small></div>
      <div class="hands-off-map" role="group" aria-label="Level 2のハンズオフ条件で絞り込む">
        {handsOffDistribution.map(({ value, label, count }) => <button type="button" data-hands-off-shortcut={value} style={`--share:${count / defaultCount}`}><span>{label}</span><strong>{count}</strong></button>)}
      </div>
      <div class="quick-filters" aria-label="注目条件ですぐに絞り込む"><button type="button" data-capability-shortcut="lane_change_support"><span>車線変更支援</span><strong>{laneChangeCount}</strong></button><button type="button" data-maker-shortcut="Tesla"><span>Tesla</span><strong>{teslaCount}</strong></button><small>Level 2・メーカー公式サイトに掲載を確認した候補</small></div>
    </div>
    <div class="guide-deck" aria-labelledby="guide-title">
      <div class="guide-deck-head"><div><span class="eyebrow">START WITH YOUR USE</span><h2 id="guide-title">使い方から、候補を減らす。</h2></div><p>Level 2の違いを、質問の代わりになる入口にまとめました。</p></div>
      <div class="guide-grid">{guideProfiles.map((profile) => <button type="button" class="guide-card" data-guide={profile.id} data-guide-values={JSON.stringify(profile.values)}><span class="guide-card-title">{profile.title}</span><span class="guide-card-description">{profile.description}</span><strong>{profile.count}件</strong></button>)}</div>
    </div>
  </div>
</div></section>

<section class="section list-section"><div class="wrap">
  <form method="get" action={action} id="vehicle-filters"><details class="filters" open>
    <summary><span>条件を絞る</span><strong data-filter-summary>すべての車</strong></summary>
    <div class="filter-content">
      <div class="filter-grid">
        <label>メーカー<select name="maker"><option value="">すべて</option>{makers.map((maker) => <option value={maker}>{maker}</option>)}</select></label>
        <label>自動化レベル<select name="level"><option value="">すべて</option>{levelIds.map((level) => <option value={level}>Level {level}</option>)}</select></label>
        <fieldset class="check-filter-group"><legend>できること（すべて満たす）</legend><div class="check-filter-grid">{capabilityOptions.map(({ id, definition, count }) => <label class="check-filter"><input type="checkbox" name="capability" value={id} /><span><strong>{definition.label}</strong><small>{definition.description}</small></span><b>{count}</b></label>)}</div></fieldset>
        <label>ハンズオフ<select name="handsOff"><option value="">すべて</option>{Object.entries(handsOffLabels).map(([key, label]) => <option value={key}>{label}</option>)}</select></label>
        <label>主な道路<select name="road"><option value="">すべて</option>{roadOptions.map((road) => <option value={road}>{road}</option>)}</select></label>
        <label>販売・利用状態<select name="availability"><option value="">公式サイト掲載あり（既定）</option><option value="all">すべての状態</option>{Object.entries(availabilityLabels).map(([key, label]) => <option value={key}>{label}</option>)}</select></label>
        <label>本体価格帯<select name="budget"><option value="">すべて</option>{priceBandOptions.map(({ value, label }) => <option value={value}>{label}</option>)}</select></label>
        <label>並び順<select name="sort"><option value="introduced_desc">発売・導入が新しい順（既定）</option><option value="price_asc">価格が安い順</option><option value="maker_asc">メーカー名順</option></select></label>
      </div>
      <p class="sort-note">発売・導入時期が未確認の車は末尾に表示します。価格帯は車両本体価格の開始値で分類し、価格未確認は含めません。</p>
      <div class="filter-actions"><button class="button alt" type="submit">この条件で探す</button><a class="button text" href={action}>リセット</a></div>
    </div>
  </details></form>
  <div class="notice list-notice" data-level2-notice hidden><strong>Level 2は運転支援です。</strong> ハンズオフ可能な条件があっても、運転者は周囲を常時監視します。</div>
  <div class="results-bar"><h2><span data-selected-label>公式サイト掲載あり</span> <span class="subtle" data-result-count aria-live="polite">{defaultCount}件</span></h2><span class="subtle results-help" data-sort-label>発売・導入が新しい順 · 時期不明は末尾</span><div class="results-actions"><button class="button small text" type="button" data-save-search>この条件を保存</button><div class="compare-toolbar" data-compare-toolbar><span class="subtle" data-compare-count>0台選択中（最大2台）</span><a class="button small alt" data-compare-link href="/compare/" aria-disabled="true">選択した車両を比較</a></div></div></div>
  <form class="compare-list" method="get" action="/compare/" id="compare-list-form"><div class="cards" data-results>{sortedVehicles.map((vehicle, index) => <div data-vehicle-shell hidden={!isDefaultListedVehicle(vehicle)} data-level={vehicle.automationLevel} data-maker={vehicle.maker} data-capabilities={vehicle.capabilities.join('|')} data-road={vehicle.odd.roadTypes.map(canonicalRoadType).join('|')} data-hands-off={vehicle.handsOff} data-availability={vehicle.availability} data-current-catalog={String(vehicle.currentCatalogListed === true)} data-introduced-at={vehicle.salesUnitIntroducedAt ?? ''} data-price-min={vehiclePriceMin(vehicle) ?? ''} data-decision-fingerprint={vehicleDecisionFingerprint(vehicle)} data-decision-signals={JSON.stringify(vehicleDecisionSignals(vehicle))} data-stable-key={`${vehicle.maker}::${vehicle.model}::${vehicle.grade}::${vehicle.id}`} data-original-index={index}><VehicleCard vehicle={vehicle} selectable /></div>)}</div></form>
  <div class="empty" data-empty hidden><h2>条件に合う候補はまだありません</h2><p>条件をゆるめるか、公式サイト掲載ありの候補に戻してお試しください。</p><a class="button text" href={action}>条件をリセット</a></div>
</div></section>

<script define:vars={{ action }}>
  // @ts-nocheck
  const form = document.querySelector('#vehicle-filters');
  const filterPanel = form?.querySelector('details');
  const results = document.querySelector('[data-results]');
  const compareForm = document.querySelector('#compare-list-form');
  const saveSearchButton = document.querySelector('[data-save-search]');
  const shells = [...document.querySelectorAll('[data-vehicle-shell]')];
  const compareInputs = [...document.querySelectorAll('#compare-list-form input[name="ids"]')];
  const levelShortcuts = [...document.querySelectorAll('[data-level-shortcut]')];
  let lastTrackedSearch = '';
  if (matchMedia('(max-width: 520px)').matches) filterPanel?.removeAttribute('open');
  const updateCompare = () => {
    const selected = compareInputs.filter((input) => input.checked).map((input) => input.value);
    compareInputs.forEach((input) => { input.disabled = !input.checked && selected.length >= 2; });
    const count = document.querySelector('[data-compare-count]'); const link = document.querySelector('[data-compare-link]');
    if (count) count.textContent = `${selected.length}台選択中（最大2台）`;
    if (link) { link.href = selected.length ? `/compare/?${selected.map((id) => `ids=${encodeURIComponent(id)}`).join('&')}` : '/compare/'; link.setAttribute('aria-disabled', selected.length === 2 ? 'false' : 'true'); }
    document.querySelector('[data-compare-toolbar]')?.toggleAttribute('data-active', selected.length > 0);
  };
  const applyFilters = (trackInteraction = false) => {
    const params = new URLSearchParams(location.search);
    const values = { maker: params.get('maker') || '', level: params.get('level') || '', capability: params.getAll('capability'), road: params.get('road') || '', handsOff: params.get('handsOff') || '', availability: params.get('availability') || '', budget: params.get('budget') || '', sort: params.get('sort') || 'introduced_desc' };
    form?.querySelectorAll('select').forEach((select) => { select.value = values[select.name] || (select.name === 'sort' ? 'introduced_desc' : ''); });
    form?.querySelectorAll('input[name="capability"]').forEach((input) => { input.checked = values.capability.includes(input.value); });
    [...shells].sort((a, b) => {
      if (values.sort === 'price_asc') { const aPrice = Number(a.dataset.priceMin || Number.POSITIVE_INFINITY); const bPrice = Number(b.dataset.priceMin || Number.POSITIVE_INFINITY); if (aPrice !== bPrice) return aPrice - bPrice; }
      if (values.sort === 'introduced_desc') { if (a.dataset.introducedAt && !b.dataset.introducedAt) return -1; if (!a.dataset.introducedAt && b.dataset.introducedAt) return 1; const dateOrder = (b.dataset.introducedAt || '').localeCompare(a.dataset.introducedAt || ''); if (dateOrder) return dateOrder; }
      return (a.dataset.stableKey || '').localeCompare(b.dataset.stableKey || '', 'ja');
    }).forEach((shell) => results?.append(shell));
    let count = 0;
    shells.forEach((shell) => {
      const defaultAvailable = shell.dataset.availability === 'new_order_available' || (shell.dataset.availability === 'unknown' && shell.dataset.currentCatalog === 'true');
      const price = Number(shell.dataset.priceMin || '');
      const hasPrice = Number.isFinite(price) && price > 0;
      const budgetMatch = !values.budget || (hasPrice && ((values.budget === 'under_300' && price < 3000000) || (values.budget === 'from_300_to_500' && price >= 3000000 && price < 5000000) || (values.budget === 'from_500_to_800' && price >= 5000000 && price < 8000000) || (values.budget === 'over_800' && price >= 8000000)));
      const shellCapabilities = (shell.dataset.capabilities || '').split('|');
      const show = (!values.maker || shell.dataset.maker === values.maker) && (!values.level || shell.dataset.level === values.level) && values.capability.every((capability) => shellCapabilities.includes(capability)) && (!values.road || (shell.dataset.road || '').split('|').includes(values.road)) && (!values.handsOff || shell.dataset.handsOff === values.handsOff) && (values.availability && values.availability !== 'all' ? shell.dataset.availability === values.availability : values.availability === 'all' ? true : defaultAvailable) && budgetMatch;
      shell.hidden = !show; const compareInput = shell.querySelector('input[name="ids"]'); if (!show && compareInput) compareInput.checked = false; if (show) count += 1;
    });
    const capabilityText = values.capability.length ? values.capability.map((capability) => form?.querySelector(`input[name="capability"][value="${capability}"]`)?.closest('label')?.querySelector('strong')?.textContent || capability).join(' ＋ ') : '';
    const handsOffText = values.handsOff ? form?.querySelector('select[name="handsOff"] option:checked')?.textContent : '';
    const roadText = values.road ? form?.querySelector('select[name="road"] option:checked')?.textContent : '';
    const availabilityText = values.availability ? form?.querySelector('select[name="availability"] option:checked')?.textContent : '';
    const budgetText = values.budget ? form?.querySelector('select[name="budget"] option:checked')?.textContent : '';
    const selection = [values.maker, values.level && `Level ${values.level}`, capabilityText, handsOffText, roadText, budgetText, availabilityText].filter(Boolean);
    const label = document.querySelector('[data-selected-label]'); if (label) label.textContent = selection.join(' · ') || '公式サイト掲載あり';
    const summary = document.querySelector('[data-filter-summary]'); if (summary) summary.textContent = selection.join(' · ') || 'すべての車';
    const resultCount = document.querySelector('[data-result-count]'); if (resultCount) resultCount.textContent = `${count}件`;
    const sortLabel = document.querySelector('[data-sort-label]'); if (sortLabel) sortLabel.textContent = values.sort === 'maker_asc' ? 'メーカー名順' : values.sort === 'price_asc' ? '価格が安い順 · 価格要確認は末尾' : '発売・導入が新しい順 · 時期不明は末尾';
    const empty = document.querySelector('[data-empty]'); if (empty) empty.hidden = count !== 0;
    const notice = document.querySelector('[data-level2-notice]'); if (notice) notice.hidden = values.level !== '2' && !values.handsOff && values.capability.length === 0;
    levelShortcuts.forEach((button) => button.setAttribute('aria-pressed', button.dataset.levelShortcut === values.level ? 'true' : 'false'));
    if (trackInteraction && location.search !== lastTrackedSearch) { window.jidouuntenTrack?.('filter_results', { filter_name: 'vehicle_filters', filter_value: `${values.maker || 'all'}|${values.level || 'all'}|${values.capability.join(',') || 'all'}|${values.road || 'all'}|${values.handsOff || 'all'}|${values.budget || 'all'}|${values.availability || 'default'}|${values.sort}`, result_count: count }); lastTrackedSearch = location.search; }
    updateCompare();
  };
  const submitValues = (values = {}, clear = false) => { if (clear) { form?.querySelectorAll('select').forEach((select) => { select.value = select.name === 'sort' ? 'introduced_desc' : ''; }); form?.querySelectorAll('input[type="checkbox"]').forEach((input) => { input.checked = false; }); } Object.entries(values).forEach(([name, value]) => { const inputs = [...(form?.querySelectorAll(`input[name="${name}"]`) || [])]; const select = form?.querySelector(`select[name="${name}"]`); if (inputs.length) { const selected = Array.isArray(value) ? value.map(String) : [String(value)]; inputs.forEach((input) => { input.checked = selected.includes(input.value); }); } else if (select) select.value = Array.isArray(value) ? value[0] || '' : value; }); form?.requestSubmit(); };
  form?.addEventListener('submit', (event) => { event.preventDefault(); const query = new URLSearchParams(new FormData(form)); [...query.entries()].forEach(([key, value]) => { if (!value || (key === 'sort' && value === 'introduced_desc')) query.delete(key); }); history.pushState({}, '', `${action}${query.toString() ? `?${query.toString()}` : ''}`); applyFilters(true); if (matchMedia('(max-width: 520px)').matches) filterPanel?.removeAttribute('open'); });
  form?.querySelector('select[name="level"]')?.addEventListener('change', (event) => window.jidouuntenTrack?.('select_level', { level: event.target.value || 'all' }));
  levelShortcuts.forEach((button) => button.addEventListener('click', () => { if (!button.disabled) submitValues({ level: button.dataset.levelShortcut || '', availability: button.dataset.availabilityShortcut || '' }, true); }));
  document.querySelector('[data-reset-shortcut]')?.addEventListener('click', () => submitValues({}, true));
  document.querySelectorAll('[data-hands-off-shortcut]').forEach((button) => button.addEventListener('click', () => submitValues({ level: '2', handsOff: button.dataset.handsOffShortcut }, true)));
  document.querySelectorAll('[data-capability-shortcut]').forEach((button) => button.addEventListener('click', () => submitValues({ level: '2', capability: button.dataset.capabilityShortcut }, true)));
  document.querySelectorAll('[data-guide]').forEach((button) => button.addEventListener('click', () => { let values; try { values = JSON.parse(button.dataset.guideValues || '{}'); } catch { values = {}; } submitValues(values, true); }));
  document.querySelectorAll('[data-maker-shortcut]').forEach((button) => button.addEventListener('click', () => submitValues({ maker: button.dataset.makerShortcut }, true)));
  compareInputs.forEach((input) => input.addEventListener('change', updateCompare));
  compareForm?.addEventListener('submit', (event) => { if (compareInputs.filter((input) => input.checked).length !== 2) event.preventDefault(); });
  document.querySelector('[data-compare-link]')?.addEventListener('click', (event) => { if (compareInputs.filter((input) => input.checked).length !== 2) event.preventDefault(); });
  saveSearchButton?.addEventListener('click', () => {
    const label = document.querySelector('[data-selected-label]')?.textContent?.trim() || '保存した検索';
    const href = `${location.pathname}${location.search}`;
    const entries = shells.filter((shell) => !shell.hidden).map((shell) => { let signals; try { signals = JSON.parse(shell.dataset.decisionSignals || 'null'); } catch { signals = undefined; } return { id: shell.querySelector('input[name="ids"]')?.value, fingerprint: shell.dataset.decisionFingerprint, signals }; }).filter((entry) => entry.id && entry.fingerprint);
    const saved = window.jidouuntenSave?.('search', href, label, { entries });
    if (saved) {
      const original = saveSearchButton.textContent;
      saveSearchButton.textContent = '保存しました';
      window.setTimeout(() => { saveSearchButton.textContent = original; }, 1800);
    }
  });
  window.addEventListener('popstate', () => applyFilters(false));
  applyFilters(false);
</script>
