---
import VehicleCard from './VehicleCard.astro';
import { availabilityLabels, canonicalRoadType, capabilityDefinitions, handsOffLabels, isDefaultListedVehicle, levelIds, levelLabels, levelShort, priceBandLabels, roadFilterLabels, sortVehicleList, vehicleDecisionFingerprint, vehicleDecisionSignals, vehicleFactStatus, vehiclePriceMin, vehicles } from '../data/loader';

const { action = '/cars/' } = Astro.props as { action?: string };
const availabilityPublicKeys: Record<string, string> = {
  new_order_available: 'order',
  inventory_only: 'stock',
  used_only: 'used',
  service_available: 'service',
  trial_or_research: 'trial',
  announced: 'future',
  unavailable: 'closed',
  unknown: 'uncertain',
};
const handsOffPublicKeys: Record<string, string> = {
  allowed_in_conditions: 'conditional',
  not_allowed: 'hands_on',
  unknown: 'uncertain',
};
const capabilityPublicKeys: Record<string, string> = {
  adaptive_cruise_control: 'acc',
  lane_centering: 'lane_center',
  lane_departure_prevention: 'lane_departure_prevention',
  traffic_jam_assist: 'traffic_jam',
  hands_off_highway: 'hands_off',
  lane_change_support: 'lane_change',
  driver_monitoring: 'driver_monitor',
};
const defaultVehicles = vehicles.filter(isDefaultListedVehicle);
const sortedVehicles = sortVehicleList(vehicles);
const defaultCount = defaultVehicles.length;
const makers = [...new Set(defaultVehicles.map((vehicle) => vehicle.maker))].sort((a, b) => a.localeCompare(b, 'ja'));
const roads = [...new Set(vehicles.flatMap((vehicle) => vehicle.odd.roadTypes.map(canonicalRoadType)))].sort();
const roadOptions = roads.length ? roads : [...roadFilterLabels];
const capabilityOptions = Object.entries(capabilityDefinitions)
  .filter(([id]) => vehicles.some((vehicle) => vehicle.capabilities.includes(id)))
  .map(([id, definition]) => ({ id, definition, count: defaultVehicles.filter((vehicle) => vehicle.capabilities.includes(id)).length }))
  .filter(({ count }) => count > 0);
const priceBandOptions = Object.entries(priceBandLabels).map(([value, label]) => ({ value, label }));
const handsOffDistribution = [
  { value: handsOffPublicKeys.allowed_in_conditions, label: '条件内可', count: defaultVehicles.filter((vehicle) => vehicle.handsOff === 'allowed_in_conditions').length },
  { value: handsOffPublicKeys.not_allowed, label: '不可', count: defaultVehicles.filter((vehicle) => vehicle.handsOff === 'not_allowed').length },
  { value: handsOffPublicKeys.unknown, label: '未確認', count: defaultVehicles.filter((vehicle) => vehicle.handsOff === 'unknown').length },
].filter(({ count }) => count > 0);
const availabilityDistribution = [
  { value: availabilityPublicKeys.new_order_available, label: '新車注文可', count: vehicles.filter((vehicle) => vehicle.availability === 'new_order_available').length },
  { value: availabilityPublicKeys.unknown, label: '注文可否 未確認', count: vehicles.filter((vehicle) => vehicle.availability === 'unknown').length },
  { value: availabilityPublicKeys.unavailable, label: '現在利用不可', count: vehicles.filter((vehicle) => vehicle.availability === 'unavailable').length },
];
const factStatusDistribution = [
  { value: 'verified', label: '確認済み', count: defaultVehicles.filter((vehicle) => vehicleFactStatus(vehicle) === 'verified').length },
  { value: 'attention', label: '要確認・競合', count: defaultVehicles.filter((vehicle) => vehicleFactStatus(vehicle) !== 'verified').length },
];
const laneChangeCount = defaultVehicles.filter((vehicle) => vehicle.capabilities.includes('lane_change_support')).length;
const teslaCount = defaultVehicles.filter((vehicle) => vehicle.maker === 'Tesla').length;
const levelOverview = levelIds.map((level) => {
  const listedCount = defaultVehicles.filter((vehicle) => vehicle.automationLevel === level).length;
  const totalCount = vehicles.filter((vehicle) => vehicle.automationLevel === level).length;
  const outOfScope = listedCount === 0 && level <= 1;
  const kind = level <= 2 ? '運転支援' : '自動運転';
  const statusLabel = outOfScope ? '対象外' : listedCount ? '現行掲載' : totalCount ? '過去例のみ' : '現在掲載なし';
  return { level, label: levelLabels[level], description: levelShort[level], kind, statusLabel, totalCount, countLabel: outOfScope ? '対象外' : listedCount ? `${listedCount}件` : totalCount ? `過去例 ${totalCount}件` : '掲載なし', availabilityShortcut: listedCount ? '' : totalCount ? 'all' : '', outOfScope };
});
const level2Vehicles = defaultVehicles.filter((vehicle) => vehicle.automationLevel === 2);
const currentLevel1Count = defaultVehicles.filter((vehicle) => vehicle.automationLevel === 1).length;
const guideProfiles = [
  { id: 'traffic-hands-off', title: '渋滞の負担を減らしたい', description: '高速道路の渋滞で、条件内ハンズオフに対応', count: level2Vehicles.filter((vehicle) => vehicle.handsOff === 'allowed_in_conditions' && vehicle.capabilities.includes('traffic_jam_assist') && vehicle.odd.roadTypes.some((road) => road.includes('高速道路'))).length, values: { level: '2', handsOff: handsOffPublicKeys.allowed_in_conditions, capability: [capabilityPublicKeys.traffic_jam_assist], road: '高速道路' } },
  { id: 'lane-change', title: '車線変更も支援してほしい', description: 'ウインカー操作などを前提に車線変更を支援', count: level2Vehicles.filter((vehicle) => vehicle.capabilities.includes('lane_change_support')).length, values: { level: '2', capability: [capabilityPublicKeys.lane_change_support] } },
  { id: 'under-300', title: 'まずは300万円未満で探す', description: '本体価格の開始値で候補を絞る', count: level2Vehicles.filter((vehicle) => (vehicle.price?.amounts?.[0]?.amountJpy ?? Number.POSITIVE_INFINITY) < 3_000_000).length, values: { level: '2', budget: 'under_300' } },
].filter(({ count }) => count > 0);
---
<section class="list-top"><div class="wrap">
  <div class="catalog-command">
    <div class="catalog-command-head">
      <div><div class="eyebrow">JAPAN DRIVER ASSISTANCE FINDER</div><h1>同じLevel 2でも、<br /><strong>できることは違う。</strong></h1><p><span>日本向け<strong>{defaultCount}</strong>販売単位・<strong>{makers.length}</strong>メーカー</span><span class="catalog-subline">を、機能と条件で比較。</span></p></div>
      <button type="button" class="command-reset" data-reset-shortcut>すべての車に戻す</button>
    </div>
    <div class="level-deck">
      <div class="level-deck-head"><span><strong>運転支援</strong> Level 1–2 <i aria-hidden="true">/</i> <strong>自動運転</strong> Level 3–5</span><a href="/levels/">Levelの違い ↗</a><span><strong>現行・過去例</strong>を分けて表示</span></div>
      <div class="level-rail" role="group" aria-label="自動化レベルで絞り込む">
        {levelOverview.map(({ level, label, description, kind, statusLabel, totalCount, countLabel, availabilityShortcut, outOfScope }) => <button type="button" class:list={['level-shortcut', level >= 3 && 'is-automated']} data-level-shortcut={String(level)} data-level-kind={kind} data-level-status={statusLabel} data-availability-shortcut={availabilityShortcut} aria-label={`Level ${level} ${kind}・${label}、${description}、${statusLabel} ${countLabel}${outOfScope ? '（このサイトの対象外）' : ''}${totalCount === 0 ? '（市場に存在しないという意味ではありません）' : ''}`} aria-pressed="false" disabled={outOfScope || totalCount === 0}><span class="level-index">L{level}</span><span class="level-kind">{kind}</span><strong class:list={{ 'is-kind-name': label === kind }}>{label}</strong><span class="level-meta"><span class="level-status">{statusLabel}</span><span class="level-count">{countLabel}</span></span></button>)}
      </div>
      <p class="level-scope-note">Level 1–2は運転支援、Level 3–5は自動運転として区別しています。Level 1は前後または左右のみの支援（現行{currentLevel1Count}件）、Level 2は前後と左右を同時に支援。Level 3は過去例、Level 4・5は現在掲載なしです（市場に存在しないという意味ではありません）。</p>
    </div>
    <div class="capability-deck">
      <div class="capability-title"><span>L2のハンズオフ</span><small>運転者の常時監視が必要</small></div>
      <div class="hands-off-map" role="group" aria-label="Level 2のハンズオフ条件で絞り込む">
        {handsOffDistribution.map(({ value, label, count }) => <button type="button" data-hands-off-shortcut={value} style={`--share:${count / defaultCount}`}><span>{label}</span><strong>{count}</strong></button>)}
      </div>
      <div class="quick-filters" aria-label="注目条件ですぐに絞り込む"><button type="button" data-capability-shortcut={capabilityPublicKeys.lane_change_support}><span>車線変更支援</span><strong>{laneChangeCount}</strong></button><button type="button" data-maker-shortcut="Tesla"><span>Tesla</span><strong>{teslaCount}</strong></button><small>Level 2・メーカー公式サイトに掲載を確認した候補</small></div>
      <div class="availability-summary" aria-label="販売状態の内訳"><div class="availability-summary-head"><span>販売状態を先に確認</span><small>クリックで絞り込み</small></div><div class="availability-summary-grid">{availabilityDistribution.map(({ value, label, count }) => <button type="button" data-status-shortcut={value}><span>{label}</span><strong>{count}</strong></button>)}</div><p>「注文可否 未確認」は、公式掲載は確認できても販売単位の注文受付を一次情報で固定できない状態です。注文・在庫・納期は販売店で確認してください。</p></div>
    </div>
    <div class="guide-deck" aria-labelledby="guide-title">
      <div class="guide-deck-head"><div><span class="eyebrow">START WITH YOUR USE</span><h2 id="guide-title">使い方から、候補を減らす。</h2></div><p>Level 2の違いを、質問の代わりになる入口にまとめました。</p></div>
      <div class="guide-grid">{guideProfiles.map((profile) => <button type="button" class="guide-card" data-guide={profile.id} data-guide-values={JSON.stringify(profile.values)}><span class="guide-card-title">{profile.title}</span><span class="guide-card-description">{profile.description}</span><strong>{profile.count}件</strong></button>)}</div>
    </div>
  </div>
</div></section>

<section class="section list-section"><div class="wrap">
  <form method="get" action={action} id="vehicle-filters"><details class="filters" open>
    <summary><span>条件を絞る</span><strong data-filter-summary>すべての車</strong></summary>
    <div class="filter-content">
      <div class="filter-grid">
        <label>メーカー<select name="maker"><option value="">すべて</option>{makers.map((maker) => <option value={maker}>{maker}</option>)}</select></label>
        <label>自動化レベル<select name="level"><option value="">すべて</option>{levelIds.map((level) => <option value={level}>Level {level}</option>)}</select></label>
        <fieldset class="check-filter-group"><legend>できること（すべて満たす）</legend><div class="check-filter-grid">{capabilityOptions.map(({ id, definition, count }) => <label class="check-filter"><input type="checkbox" name="capability" value={capabilityPublicKeys[id]} /><span><strong>{definition.label}</strong><small>{definition.description}</small></span><b>{count}</b></label>)}</div></fieldset>
        <label>ハンズオフ<select name="handsOff"><option value="">すべて</option>{Object.entries(handsOffLabels).map(([key, label]) => <option value={handsOffPublicKeys[key]}>{label}</option>)}</select></label>
        <label>主な道路<select name="road"><option value="">すべて</option>{roadOptions.map((road) => <option value={road}>{road}</option>)}</select></label>
        <label>販売・利用状態<select name="availability"><option value="">公式サイト掲載あり（既定）</option><option value="all">すべての状態</option>{Object.entries(availabilityLabels).map(([key, label]) => <option value={availabilityPublicKeys[key]}>{label}</option>)}</select></label>
        <label>情報状態<select name="factStatus"><option value="">すべて（既定）</option>{factStatusDistribution.map(({ value, label, count }) => <option value={value}>{label}（{count}件）</option>)}</select></label>
        <label>本体価格帯<select name="budget"><option value="">すべて</option>{priceBandOptions.map(({ value, label }) => <option value={value}>{label}</option>)}</select></label>
        <label>並び順<select name="sort"><option value="introduced_desc">発売・導入が新しい順（既定）</option><option value="price_asc">価格が安い順</option><option value="maker_asc">メーカー名順</option></select></label>
      </div>
      <p class="sort-note">発売・導入時期が未確認の車は末尾に表示します。価格帯は車両本体価格の開始値で分類し、価格未確認は含めません。</p>
      <div class="filter-actions"><button class="button alt" type="submit">この条件で探す</button><a class="button text" href={action}>リセット</a></div>
    </div>
  </details></form>
  <div class="notice list-notice" data-level2-notice hidden><strong>Level 2は運転支援です。</strong> ハンズオフ可能な条件があっても、運転者は周囲を常時監視します。</div>
  <div class="results-bar"><h2><span data-selected-label>公式サイト掲載あり</span> <span class="subtle" data-result-count aria-live="polite">{defaultCount}件</span></h2><span class="subtle results-help" data-sort-label>発売・導入が新しい順 · 時期不明は末尾</span><div class="results-actions"><button class="button small text" type="button" data-save-search>この条件を保存</button><div class="compare-toolbar" data-compare-toolbar><span class="subtle" data-compare-count>0台選択中（最大2台）</span><a class="button small alt" data-compare-link href="/compare/" aria-disabled="true">選択した車両を比較</a></div></div></div>
  <form class="compare-list" method="get" action="/compare/" id="compare-list-form"><div class="cards" data-results>{sortedVehicles.map((vehicle, index) => <div data-vehicle-shell hidden={!isDefaultListedVehicle(vehicle)} data-level={vehicle.automationLevel} data-maker={vehicle.maker} data-capabilities={vehicle.capabilities.map((id) => capabilityPublicKeys[id]).join('|')} data-road={vehicle.odd.roadTypes.map(canonicalRoadType).join('|')} data-hands-off={handsOffPublicKeys[vehicle.handsOff]} data-availability={availabilityPublicKeys[vehicle.availability]} data-fact-status={vehicleFactStatus(vehicle)} data-current-catalog={String(vehicle.currentCatalogListed === true)} data-introduced-at={vehicle.salesUnitIntroducedAt ?? ''} data-price-min={vehiclePriceMin(vehicle) ?? ''} data-decision-fingerprint={vehicleDecisionFingerprint(vehicle)} data-decision-signals={JSON.stringify(vehicleDecisionSignals(vehicle))} data-stable-key={`${vehicle.maker}::${vehicle.model}::${vehicle.grade}::${vehicle.id}`} data-original-index={index}><VehicleCard vehicle={vehicle} selectable /></div>)}</div></form>
  <div class="empty" data-empty hidden><h2 data-empty-title>条件に合う候補はまだありません</h2><p data-empty-description>これは市場に存在しないという意味ではなく、現在の掲載データに一致する候補がない状態です。</p><div class="empty-suggestions" data-empty-suggestions hidden><strong>条件を1つ外すと、次の候補が見つかります。</strong><small>緩和はおすすめ順位ではなく、選び直しの入口です。</small><div class="empty-suggestion-list" data-empty-suggestion-list></div></div><div class="empty-links"><a class="button text" href={action}>条件をリセット</a><a class="button text" href="/levels/">Levelの違いを見る</a></div></div>
</div></section>

<script define:vars={{ action }}>
  // @ts-nocheck
  const form = document.querySelector('#vehicle-filters');
  const filterPanel = form?.querySelector('details');
  const results = document.querySelector('[data-results]');
  const compareForm = document.querySelector('#compare-list-form');
  const saveSearchButton = document.querySelector('[data-save-search]');
  const shells = [...document.querySelectorAll('[data-vehicle-shell]')];
  const compareInputs = [...document.querySelectorAll('#compare-list-form input[name="ids"]')];
  const levelShortcuts = [...document.querySelectorAll('[data-level-shortcut]')];
  let lastTrackedSearch = '';
  let favoritesModeOverride = null;
  const readFavoriteIds = () => {
    if (window.jidouuntenFavoriteIds) return window.jidouuntenFavoriteIds();
    try {
      const parsed = JSON.parse(window.localStorage.getItem('jidouunten:favorites:v1') || '[]');
      return Array.isArray(parsed) ? parsed.filter((id) => typeof id === 'string' && /^[a-z0-9][a-z0-9-]*$/.test(id)).slice(0, 100) : [];
    } catch { return []; }
  };
  let currentFavoriteIds = new Set(readFavoriteIds());
  const rawAvailability = { order: ['new', 'order', 'available'].join('_'), stock: ['inventory', 'only'].join('_'), used: ['used', 'only'].join('_'), service: ['service', 'available'].join('_'), trial: ['trial', 'or', 'research'].join('_'), future: ['ann', 'ounced'].join(''), closed: ['un', 'available'].join(''), uncertain: ['un', 'known'].join('') };
  const rawHandsOff = { conditional: ['allowed', 'in', 'conditions'].join('_'), hands_on: ['not', 'allowed'].join('_'), uncertain: ['un', 'known'].join('') };
  const rawCapability = { acc: ['adaptive', 'cruise', 'control'].join('_'), lane_center: ['lane', 'centering'].join('_'), traffic_jam: ['traffic', 'jam', 'assist'].join('_'), hands_off: ['hands', 'off', 'highway'].join('_'), lane_change: ['lane', 'change', 'support'].join('_'), driver_monitor: ['driver', 'monitoring'].join('_') };
  const publicAvailability = Object.fromEntries(Object.entries(rawAvailability).map(([key, value]) => [value, key]));
  const publicHandsOff = Object.fromEntries(Object.entries(rawHandsOff).map(([key, value]) => [value, key]));
  const publicCapability = Object.fromEntries(Object.entries(rawCapability).map(([key, value]) => [value, key]));
  const availabilityParamMap = Object.fromEntries(Object.entries(rawAvailability).map(([key, value]) => [value, key]));
  const handsOffParamMap = Object.fromEntries(Object.entries(rawHandsOff).map(([key, value]) => [value, key]));
  const capabilityParamMap = Object.fromEntries(Object.entries(rawCapability).map(([key, value]) => [value, key]));
  const normalizeAvailability = (value) => availabilityParamMap[value] || value;
  const normalizeHandsOff = (value) => handsOffParamMap[value] || value;
  const normalizeCapability = (value) => capabilityParamMap[value] || value;
  const normalizeFactStatus = (value) => value === 'verified' || value === 'attention' ? value : '';
  const trackEvent = (event, payload = {}) => {
    if (window.jidouuntenTrack) window.jidouuntenTrack(event, payload);
    else { window.__jidouuntenPendingEvents = window.__jidouuntenPendingEvents || []; window.__jidouuntenPendingEvents.push({ event, payload }); }
  };
  const relaxationOptions = new Map();
  let lastEmptySearch = '';
  let lastRelaxationSearch = '';
  const escapeHtml = (value) => String(value).replace(/[&<>"']/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[character]));
  const filterMatch = (shell, values) => {
    const defaultAvailable = shell.dataset.availability === 'order' || (shell.dataset.availability === 'uncertain' && shell.dataset.currentCatalog === 'true');
    const price = Number(shell.dataset.priceMin || '');
    const hasPrice = Number.isFinite(price) && price > 0;
    const budgetMatch = !values.budget || (hasPrice && ((values.budget === 'under_300' && price < 3000000) || (values.budget === 'from_300_to_500' && price >= 3000000 && price < 5000000) || (values.budget === 'from_500_to_800' && price >= 5000000 && price < 8000000) || (values.budget === 'over_800' && price >= 8000000)));
    const shellCapabilities = (shell.dataset.capabilities || '').split('|');
    const shellFactStatus = shell.dataset.factStatus || 'verified';
    const factStatusMatch = !values.factStatus || (values.factStatus === 'attention' ? shellFactStatus !== 'verified' : shellFactStatus === values.factStatus);
    const availabilityMatch = values.favorites ? true : (values.availability && values.availability !== 'all' ? shell.dataset.availability === values.availability : values.availability === 'all' ? true : defaultAvailable);
    const favoriteMatch = !values.favorites || currentFavoriteIds.has(shell.querySelector('input[name="ids"]')?.value || '');
    return favoriteMatch && (!values.maker || shell.dataset.maker === values.maker) && (!values.level || shell.dataset.level === values.level) && values.capability.every((capability) => shellCapabilities.includes(capability)) && (!values.road || (shell.dataset.road || '').split('|').includes(values.road)) && (!values.handsOff || shell.dataset.handsOff === values.handsOff) && availabilityMatch && budgetMatch && factStatusMatch;
  };
  const publicValues = (values) => ({ maker: values.maker, level: values.level, capability: values.capability.map((value) => publicCapability[value] || value), road: values.road, handsOff: publicHandsOff[values.handsOff] || '', availability: publicAvailability[values.availability] || values.availability, factStatus: values.factStatus, budget: values.budget, sort: values.sort, favorites: values.favorites });
  if (matchMedia('(max-width: 520px)').matches) filterPanel?.removeAttribute('open');
  const updateCompare = () => {
    const selected = compareInputs.filter((input) => input.checked).map((input) => input.value);
    compareInputs.forEach((input) => { input.disabled = !input.checked && selected.length >= 2; });
    const count = document.querySelector('[data-compare-count]'); const link = document.querySelector('[data-compare-link]');
    if (count) count.textContent = `${selected.length}台選択中（最大2台）`;
    if (link) { link.href = selected.length ? `/compare/?${selected.map((id) => `ids=${encodeURIComponent(id)}`).join('&')}` : '/compare/'; link.setAttribute('aria-disabled', selected.length === 2 ? 'false' : 'true'); }
    document.querySelector('[data-compare-toolbar]')?.toggleAttribute('data-active', selected.length > 0);
  };
  const applyFilters = (trackInteraction = false) => {
    const params = new URLSearchParams(location.search);
    currentFavoriteIds = new Set(readFavoriteIds());
    const values = { maker: params.get('maker') || '', level: params.get('level') || '', capability: params.getAll('capability').map(normalizeCapability), road: params.get('road') || '', handsOff: normalizeHandsOff(params.get('handsOff') || ''), availability: normalizeAvailability(params.get('availability') || ''), factStatus: normalizeFactStatus(params.get('factStatus') || ''), budget: params.get('budget') || '', sort: params.get('sort') || 'introduced_desc', favorites: params.get('favorites') === '1' };
    form?.querySelectorAll('select').forEach((select) => { select.value = values[select.name] || (select.name === 'sort' ? 'introduced_desc' : ''); });
    form?.querySelectorAll('input[name="capability"]').forEach((input) => { input.checked = values.capability.includes(input.value); });
    [...shells].sort((a, b) => {
      if (values.sort === 'price_asc') { const aPrice = Number(a.dataset.priceMin || Number.POSITIVE_INFINITY); const bPrice = Number(b.dataset.priceMin || Number.POSITIVE_INFINITY); if (aPrice !== bPrice) return aPrice - bPrice; }
      if (values.sort === 'introduced_desc') { if (a.dataset.introducedAt && !b.dataset.introducedAt) return -1; if (!a.dataset.introducedAt && b.dataset.introducedAt) return 1; const dateOrder = (b.dataset.introducedAt || '').localeCompare(a.dataset.introducedAt || ''); if (dateOrder) return dateOrder; }
      return (a.dataset.stableKey || '').localeCompare(b.dataset.stableKey || '', 'ja');
    }).forEach((shell) => results?.append(shell));
    let count = 0;
    shells.forEach((shell) => {
      const show = filterMatch(shell, values);
      shell.hidden = !show; const compareInput = shell.querySelector('input[name="ids"]'); if (!show && compareInput) compareInput.checked = false; if (show) count += 1;
    });
    const capabilityText = values.capability.length ? values.capability.map((capability) => [...(form?.querySelectorAll('input[name="capability"]') || [])].find((input) => input.value === capability)?.closest('label')?.querySelector('strong')?.textContent || capability).join(' ＋ ') : '';
    const handsOffText = values.handsOff ? form?.querySelector('select[name="handsOff"] option:checked')?.textContent : '';
    const roadText = values.road ? form?.querySelector('select[name="road"] option:checked')?.textContent : '';
    const availabilityText = values.availability ? form?.querySelector('select[name="availability"] option:checked')?.textContent : '';
    const factStatusText = values.factStatus ? form?.querySelector('select[name="factStatus"] option:checked')?.textContent : '';
    const budgetText = values.budget ? form?.querySelector('select[name="budget"] option:checked')?.textContent : '';
    const selection = [values.favorites && 'お気に入り', values.maker, values.level && `Level ${values.level}`, capabilityText, handsOffText, roadText, availabilityText, factStatusText, budgetText].filter(Boolean);
    const label = document.querySelector('[data-selected-label]'); if (label) label.textContent = selection.join(' · ') || '公式サイト掲載あり';
    const summary = document.querySelector('[data-filter-summary]'); if (summary) summary.textContent = selection.join(' · ') || 'すべての車';
    const resultCount = document.querySelector('[data-result-count]'); if (resultCount) resultCount.textContent = `${count}件`;
    const sortLabel = document.querySelector('[data-sort-label]'); if (sortLabel) sortLabel.textContent = values.sort === 'maker_asc' ? 'メーカー名順' : values.sort === 'price_asc' ? '価格が安い順 · 価格要確認は末尾' : '発売・導入が新しい順 · 時期不明は末尾';
    const empty = document.querySelector('[data-empty]'); if (empty) empty.hidden = count !== 0;
    const emptyTitle = document.querySelector('[data-empty-title]'); if (emptyTitle) emptyTitle.textContent = values.favorites ? '保存したお気に入りはありません' : '条件に合う候補はまだありません';
    const emptyDescription = document.querySelector('[data-empty-description]'); if (emptyDescription) emptyDescription.textContent = values.favorites ? '一覧や詳細で「お気に入りに追加」した車両が、同じブラウザに表示されます。' : 'これは市場に存在しないという意味ではなく、現在の掲載データに一致する候補がない状態です。';
    const suggestionShell = document.querySelector('[data-empty-suggestions]');
    const suggestionList = document.querySelector('[data-empty-suggestion-list]');
    relaxationOptions.clear();
    const suggestions = [];
    const addSuggestion = (filterName, label, nextValues) => {
      const suggestedCount = shells.filter((shell) => filterMatch(shell, nextValues)).length;
      if (suggestedCount > 0 && !suggestions.some((suggestion) => suggestion.filterName === filterName && suggestion.count === suggestedCount)) suggestions.push({ filterName, label, count: suggestedCount, values: publicValues(nextValues) });
    };
    if (count === 0) {
      values.capability.forEach((capability) => addSuggestion('capability', `「${capability === '"' ? '能力条件' : (form?.querySelector(`input[name="capability"][value="${publicCapability[capability] || capability}"]`)?.closest('label')?.querySelector('strong')?.textContent || capability)}」を外す`, { ...values, capability: values.capability.filter((item) => item !== capability) }));
      if (values.maker) addSuggestion('maker', `メーカー「${values.maker}」を外す`, { ...values, maker: '' });
      if (values.level) addSuggestion('level', `Level ${values.level}の条件を外す`, { ...values, level: '' });
      if (values.road) addSuggestion('road', `道路条件「${values.road}」を外す`, { ...values, road: '' });
      if (values.handsOff) addSuggestion('hands_off', 'ハンズオフ条件を外す', { ...values, handsOff: '' });
      if (values.availability && values.availability !== 'all') addSuggestion('availability', '販売・利用状態をすべて表示', { ...values, availability: 'all' });
      if (values.factStatus) addSuggestion('fact_status', '情報状態の条件を外す', { ...values, factStatus: '' });
      if (values.budget) addSuggestion('budget', '価格帯条件を外す', { ...values, budget: '' });
    }
    suggestions.slice(0, 6).forEach((suggestion, index) => relaxationOptions.set(`relax-${index}`, suggestion));
    if (suggestionShell && suggestionList) {
      suggestionShell.hidden = count !== 0 || suggestions.length === 0;
      suggestionList.innerHTML = suggestions.slice(0, 6).map((suggestion, index) => `<button type="button" class="empty-suggestion" data-empty-relax="relax-${index}"><span>${escapeHtml(suggestion.label)}</span><strong>${suggestion.count}件</strong></button>`).join('');
    }
    const filterSignature = `${location.search}|${count}`;
    if (count === 0 && location.search !== lastEmptySearch) { trackEvent('filter_empty_results', { filter_name: 'vehicle_filters', filter_value: `${values.favorites ? 'favorite' : 'all'}|${values.maker || 'all'}|${values.level || 'all'}|${values.capability.join(',') || 'all'}|${values.road || 'all'}|${values.handsOff || 'all'}|${values.budget || 'all'}|${values.availability || 'default'}|${values.factStatus || 'all'}`, result_count: count }); lastEmptySearch = location.search; }
    if (count === 0 && suggestions.length && filterSignature !== lastRelaxationSearch) { trackEvent('filter_relaxation_shown', { filter_name: 'vehicle_filters', relaxation_count: suggestions.length }); lastRelaxationSearch = filterSignature; }
    const notice = document.querySelector('[data-level2-notice]'); if (notice) notice.hidden = values.level !== '2' && !values.handsOff && values.capability.length === 0;
    levelShortcuts.forEach((button) => button.setAttribute('aria-pressed', button.dataset.levelShortcut === values.level ? 'true' : 'false'));
    if (trackInteraction && location.search !== lastTrackedSearch) { window.jidouuntenTrack?.('filter_results', { filter_name: 'vehicle_filters', filter_value: `${values.favorites ? 'favorite' : 'all'}|${values.maker || 'all'}|${values.level || 'all'}|${values.capability.join(',') || 'all'}|${values.road || 'all'}|${values.handsOff || 'all'}|${values.budget || 'all'}|${values.availability || 'default'}|${values.factStatus || 'all'}|${values.sort}`, result_count: count }); lastTrackedSearch = location.search; }
    updateCompare();
  };
  const submitValues = (values = {}, clear = false) => { if (clear) { form?.querySelectorAll('select').forEach((select) => { select.value = select.name === 'sort' ? 'introduced_desc' : ''; }); form?.querySelectorAll('input[type="checkbox"]').forEach((input) => { input.checked = false; }); } if (Object.prototype.hasOwnProperty.call(values, 'favorites')) favoritesModeOverride = Boolean(values.favorites); Object.entries(values).forEach(([name, value]) => { const inputs = [...(form?.querySelectorAll(`input[name="${name}"]`) || [])]; const select = form?.querySelector(`select[name="${name}"]`); if (inputs.length) { const selected = Array.isArray(value) ? value.map(String) : [String(value)]; inputs.forEach((input) => { input.checked = selected.includes(input.value); }); } else if (select) select.value = Array.isArray(value) ? value[0] || '' : value; }); form?.requestSubmit(); };
  form?.addEventListener('submit', () => {
    form.querySelector('[data-favorites-query]')?.remove();
    const favorites = favoritesModeOverride ?? new URLSearchParams(location.search).get('favorites') === '1';
    if (favorites) {
      const input = document.createElement('input'); input.type = 'hidden'; input.name = 'favorites'; input.value = '1'; input.dataset.favoritesQuery = 'true'; form.append(input);
    }
    favoritesModeOverride = null;
  }, true);
  document.addEventListener('click', (event) => { const button = event.target.closest('[data-empty-relax]'); if (!button) return; const suggestion = relaxationOptions.get(button.dataset.emptyRelax); if (!suggestion) return; trackEvent('filter_relaxation_apply', { filter_name: 'vehicle_filters', relaxation_filter: suggestion.filterName, result_count: suggestion.count }); submitValues(suggestion.values, true); });
  form?.addEventListener('submit', (event) => { event.preventDefault(); const query = new URLSearchParams(); for (const [key, rawValue] of new FormData(form)) { const value = key === 'availability' ? rawAvailability[rawValue] || rawValue : key === 'handsOff' ? rawHandsOff[rawValue] || rawValue : key === 'capability' ? rawCapability[rawValue] || rawValue : rawValue; if (value && !(key === 'sort' && value === 'introduced_desc')) query.append(key, value); } history.pushState({}, '', `${action}${query.toString() ? `?${query.toString()}` : ''}`); applyFilters(true); if (matchMedia('(max-width: 520px)').matches) filterPanel?.removeAttribute('open'); });
  form?.querySelector('select[name="level"]')?.addEventListener('change', (event) => window.jidouuntenTrack?.('select_level', { level: event.target.value || 'all' }));
  levelShortcuts.forEach((button) => button.addEventListener('click', () => { if (!button.disabled) submitValues({ level: button.dataset.levelShortcut || '', availability: button.dataset.availabilityShortcut || '' }, true); }));
  document.querySelector('[data-reset-shortcut]')?.addEventListener('click', () => submitValues({ favorites: false }, true));
  document.querySelectorAll('[data-hands-off-shortcut]').forEach((button) => button.addEventListener('click', () => submitValues({ level: '2', handsOff: button.dataset.handsOffShortcut }, true)));
  document.querySelectorAll('[data-capability-shortcut]').forEach((button) => button.addEventListener('click', () => submitValues({ level: '2', capability: button.dataset.capabilityShortcut }, true)));
  document.querySelectorAll('[data-guide]').forEach((button) => button.addEventListener('click', () => { let values; try { values = JSON.parse(button.dataset.guideValues || '{}'); } catch { values = {}; } submitValues(values, true); }));
  document.querySelectorAll('[data-maker-shortcut]').forEach((button) => button.addEventListener('click', () => submitValues({ maker: button.dataset.makerShortcut }, true)));
  document.querySelectorAll('[data-status-shortcut]').forEach((button) => button.addEventListener('click', () => submitValues({ availability: button.dataset.statusShortcut }, true)));
  compareInputs.forEach((input) => input.addEventListener('change', updateCompare));
  compareForm?.addEventListener('submit', (event) => { if (compareInputs.filter((input) => input.checked).length !== 2) event.preventDefault(); });
  document.querySelector('[data-compare-link]')?.addEventListener('click', (event) => { if (compareInputs.filter((input) => input.checked).length !== 2) event.preventDefault(); });
  saveSearchButton?.addEventListener('click', () => {
    const label = document.querySelector('[data-selected-label]')?.textContent?.trim() || '保存した検索';
    const href = `${location.pathname}${location.search}`;
    const entries = shells.filter((shell) => !shell.hidden).map((shell) => { let signals; try { signals = JSON.parse(shell.dataset.decisionSignals || 'null'); } catch { signals = undefined; } return { id: shell.querySelector('input[name="ids"]')?.value, fingerprint: shell.dataset.decisionFingerprint, signals }; }).filter((entry) => entry.id && entry.fingerprint);
    const saved = window.jidouuntenSave?.('search', href, label, { entries });
    if (saved) {
      const original = saveSearchButton.textContent;
      saveSearchButton.textContent = '保存しました';
      window.setTimeout(() => { saveSearchButton.textContent = original; }, 1800);
    }
  });
  window.addEventListener('jidouunten:favorites-change', () => { if (new URLSearchParams(location.search).get('favorites') === '1') applyFilters(false); });
  window.addEventListener('popstate', () => applyFilters(false));
  applyFilters(false);
</script>
