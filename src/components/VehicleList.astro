---
import VehicleCard from './VehicleCard.astro';
import { availabilityLabels, canonicalRoadType, handsOffLabels, isDefaultListedVehicle, levelIds, levelLabels, levelShort, roadFilterLabels, vehicles } from '../data/loader';

const { action = '/cars/' } = Astro.props as { action?: string };
const roads = [...new Set(vehicles.flatMap((vehicle) => vehicle.odd.roadTypes.map(canonicalRoadType)))].sort();
const roadOptions = roads.length ? roads : [...roadFilterLabels];
const defaultVehicles = vehicles.filter(isDefaultListedVehicle);
const defaultCount = defaultVehicles.length;
const makerCount = new Set(defaultVehicles.map((vehicle) => vehicle.maker)).size;
const handsOffCount = defaultVehicles.filter((vehicle) => vehicle.handsOff === 'allowed_in_conditions').length;
const levelOverview = levelIds.map((level) => {
  const listedCount = defaultVehicles.filter((vehicle) => vehicle.automationLevel === level).length;
  const totalCount = vehicles.filter((vehicle) => vehicle.automationLevel === level).length;
  return {
    level,
    label: levelLabels[level],
    description: levelShort[level],
    listedCount,
    totalCount,
    countLabel: listedCount ? `${listedCount}件` : totalCount ? `過去例 ${totalCount}件` : '0件',
    availabilityShortcut: listedCount ? '' : totalCount ? 'all' : '',
  };
});
---
<section class="list-top">
  <div class="wrap">
    <div class="catalog-command">
      <div class="catalog-summary">
        <div class="eyebrow">VEHICLE CATALOG / JAPAN</div>
        <h1><strong class="catalog-count">{defaultCount}</strong><span>販売単位を<br />レベルから選ぶ。</span></h1>
        <div class="catalog-proof" aria-label={`掲載規模: ${makerCount}メーカー、条件内ハンズオフ${handsOffCount}件`}>
          <span><strong>{makerCount}</strong> メーカー横断</span>
          <span><strong>{handsOffCount}</strong> 条件内ハンズオフ</span>
        </div>
      </div>
      <div class="level-deck">
        <div class="level-deck-head">
          <div>
            <span class="level-deck-title">LEVEL MAP</span>
            <p>Level 2までは運転支援。Level 3から自動運転。</p>
          </div>
          <a href="/levels/">違いを確認 <span aria-hidden="true">↗</span></a>
        </div>
        <div class="level-rail" role="group" aria-label="自動化レベルで絞り込む">
          <button type="button" class="level-shortcut is-all" data-level-shortcut="" data-availability-shortcut="" aria-pressed="true">
            <span class="level-index">ALL</span><strong>すべて</strong><span class="level-count">{defaultCount}件</span>
          </button>
          {levelOverview.map(({ level, label, description, totalCount, countLabel, availabilityShortcut }) => (
            <button
              type="button"
              class:list={['level-shortcut', level >= 3 && 'is-automated']}
              data-level-shortcut={String(level)}
              data-availability-shortcut={availabilityShortcut}
              aria-label={`Level ${level} ${label}、${description}、${countLabel}`}
              aria-pressed="false"
              disabled={totalCount === 0}
            >
              <span class="level-index">L{level}</span><strong>{label}</strong><span class="level-count">{countLabel}</span>
            </button>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
<section class="section list-section" style="padding-top: 8px;"><div class="wrap">
  <form class="filters" method="get" action={action} id="vehicle-filters">
    <div class="filter-grid">
      <label>自動化レベル<select name="level"><option value="">すべて</option>{[1, 2, 3, 4, 5].map((level) => <option value={level}>Level {level}</option>)}</select></label>
      <label>主な道路<select name="road"><option value="">すべて</option>{roadOptions.map((road) => <option value={road}>{road}</option>)}</select></label>
      <label>ハンズオフ<select name="handsOff"><option value="">すべて</option>{Object.entries(handsOffLabels).map(([key, label]) => <option value={key}>{label}</option>)}</select></label>
      <label>販売・利用状態<select name="availability"><option value="">カタログ掲載確認（既定）</option><option value="all">すべての状態</option>{Object.entries(availabilityLabels).map(([key, label]) => <option value={key}>{label}</option>)}</select></label>
    </div>
    <div class="filter-actions"><button class="button alt" type="submit">この条件で探す</button><a class="button text" href={action}>リセット</a></div>
  </form>
  <div class="notice list-notice" data-level2-notice hidden><strong>Level 2：常時監視が必要です。</strong><br />ハンズオフ可能な条件があっても、運転者は周囲を監視し、いつでも引き継げる状態を保ちます。</div>
  <div class="results-bar">
    <h2><span data-selected-label>カタログ掲載確認</span> <span class="subtle" data-result-count aria-live="polite">{defaultCount}件</span></h2>
    <span class="subtle results-help">URLに条件を保存できます</span>
    <div class="compare-toolbar" data-compare-toolbar>
      <span class="subtle" data-compare-count>0台選択中（最大2台）</span>
      <a class="button small alt" data-compare-link href="/compare/" aria-disabled="true">選択した車両を比較</a>
    </div>
  </div>
  <form class="compare-list" method="get" action="/compare/" id="compare-list-form">
    <div class="cards" data-results>{vehicles.map((vehicle) => <div data-vehicle-shell hidden={vehicle.availability !== 'new_order_available' && !(vehicle.availability === 'unknown' && vehicle.currentCatalogListed === true)} data-level={vehicle.automationLevel} data-road={vehicle.odd.roadTypes.map(canonicalRoadType).join('|')} data-hands-off={vehicle.handsOff} data-availability={vehicle.availability} data-current-catalog={String(vehicle.currentCatalogListed === true)}><VehicleCard vehicle={vehicle} selectable /></div>)}</div>
  </form>
  <div class="empty" data-empty hidden><h2>条件に合う候補はまだありません</h2><p>販売状態を「すべて」にするか、道路・ハンズオフの条件をゆるめてお試しください。データ未登録の場合もこの表示になります。</p><a class="button text" href={action}>条件をリセット</a></div>
</div></section>
<script define:vars={{ action }}>
  // @ts-nocheck
  const form = document.querySelector('#vehicle-filters');
  const compareForm = document.querySelector('#compare-list-form');
  const shells = [...document.querySelectorAll('[data-vehicle-shell]')];
  const compareInputs = [...document.querySelectorAll('#compare-list-form input[name="ids"]')];
  const levelShortcuts = [...document.querySelectorAll('[data-level-shortcut]')];
  let lastTrackedSearch = '';
  const updateCompare = () => {
    const selected = compareInputs.filter((input) => input.checked).map((input) => input.value);
    compareInputs.forEach((input) => { input.disabled = !input.checked && selected.length >= 2; });
    const count = document.querySelector('[data-compare-count]');
    const link = document.querySelector('[data-compare-link]');
    if (count) count.textContent = `${selected.length}台選択中（最大2台）`;
    if (link) {
      link.href = selected.length ? `/compare/?${selected.map((id) => `ids=${encodeURIComponent(id)}`).join('&')}` : '/compare/';
      link.setAttribute('aria-disabled', selected.length === 2 ? 'false' : 'true');
    }
    document.querySelector('[data-compare-toolbar]')?.toggleAttribute('data-active', selected.length > 0);
  };
  const applyFilters = (trackInteraction = false) => {
    const params = new URLSearchParams(location.search);
    const level = params.get('level') || '';
    const road = params.get('road') || '';
    const handsOff = params.get('handsOff') || '';
    const availability = params.get('availability') || '';
    form?.querySelectorAll('select').forEach((select) => { select.value = params.get(select.name) || ''; });
    let count = 0;
    shells.forEach((shell) => {
      const defaultAvailable = shell.dataset.availability === 'new_order_available' || (shell.dataset.availability === 'unknown' && shell.dataset.currentCatalog === 'true');
      const show = (!level || shell.dataset.level === level) && (!road || (shell.dataset.road || '').split('|').includes(road)) && (!handsOff || shell.dataset.handsOff === handsOff) && (availability && availability !== 'all' ? shell.dataset.availability === availability : availability === 'all' ? true : defaultAvailable);
      shell.hidden = !show;
      const compareInput = shell.querySelector('input[name="ids"]');
      if (!show && compareInput) compareInput.checked = false;
      if (show) count += 1;
    });
    const label = document.querySelector('[data-selected-label]'); if (label) label.textContent = level ? `Level ${level}` : 'カタログ掲載確認';
    const resultCount = document.querySelector('[data-result-count]'); if (resultCount) resultCount.textContent = `${count}件`;
    const empty = document.querySelector('[data-empty]'); if (empty) empty.hidden = count !== 0;
    const notice = document.querySelector('[data-level2-notice]'); if (notice) notice.hidden = level !== '2';
    levelShortcuts.forEach((button) => button.setAttribute('aria-pressed', button.dataset.levelShortcut === level ? 'true' : 'false'));
    if (trackInteraction && location.search !== lastTrackedSearch) { window.jidouuntenTrack?.('filter_results', { filter_name: 'vehicle_filters', filter_value: `${level || 'all'}|${road || 'all'}|${handsOff || 'all'}|${availability || 'default'}`, result_count: count }); lastTrackedSearch = location.search; }
    updateCompare();
  };
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const query = new URLSearchParams(new FormData(form));
    [...query.entries()].forEach(([key, value]) => { if (!value) query.delete(key); });
    history.pushState({}, '', `${action}${query.toString() ? `?${query.toString()}` : ''}`);
    applyFilters(true);
  });
  form?.querySelector('select[name="level"]')?.addEventListener('change', (event) => {
    window.jidouuntenTrack?.('select_level', { level: event.target.value || 'all' });
  });
  levelShortcuts.forEach((button) => button.addEventListener('click', () => {
    if (button.disabled) return;
    const level = button.dataset.levelShortcut || '';
    const levelSelect = form?.querySelector('select[name="level"]');
    const availabilitySelect = form?.querySelector('select[name="availability"]');
    if (levelSelect) levelSelect.value = level;
    if (availabilitySelect) availabilitySelect.value = button.dataset.availabilityShortcut || '';
    window.jidouuntenTrack?.('select_level', { level: level || 'all', source: 'level_map' });
    form?.requestSubmit();
  }));
  compareInputs.forEach((input) => input.addEventListener('change', updateCompare));
  compareForm?.addEventListener('submit', (event) => {
    const selected = compareInputs.filter((input) => input.checked);
    if (selected.length !== 2) event.preventDefault();
  });
  document.querySelector('[data-compare-link]')?.addEventListener('click', (event) => {
    if (compareInputs.filter((input) => input.checked).length !== 2) event.preventDefault();
  });
  window.addEventListener('popstate', () => applyFilters(false));
  applyFilters(false);
</script>
