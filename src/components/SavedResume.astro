---
import { vehicleDecisionFingerprint, vehicleReferenceLabel, vehicles } from '../data/loader';

const resumeCatalog = vehicles.map((vehicle) => ({
  id: vehicle.id,
  fingerprint: vehicleDecisionFingerprint(vehicle),
  label: `${vehicle.maker} ${vehicle.model} · ${vehicleReferenceLabel(vehicle)} · ${vehicle.grade}`,
}));
const resumeCatalogJson = JSON.stringify(resumeCatalog).replace(/</g, '\\u003c');
---

<aside class="saved-resume" data-saved-resume hidden aria-live="polite">
  <div class="wrap saved-resume-inner">
    <div class="saved-resume-copy"><span class="eyebrow">PICK UP WHERE YOU LEFT OFF</span><strong>保存した続き</strong><span data-saved-resume-note>同じブラウザに保存しています。端末間では同期しません。</span></div>
    <div class="saved-resume-actions" data-saved-resume-actions></div>
  </div>
</aside>

<script id="saved-resume-catalog" type="application/json" set:html={resumeCatalogJson}></script>

<script>
  // @ts-nocheck
  import { deleteSavedResume, readSavedResumeState, updateSavedResume } from '../lib/saved-resume';
  const catalogElement = document.querySelector('#saved-resume-catalog');
  let catalog = [];
  try { catalog = JSON.parse(catalogElement?.textContent || '[]'); } catch { catalog = []; }
  const shell = document.querySelector('[data-saved-resume]');
  const actions = shell?.querySelector('[data-saved-resume-actions]');
  const note = shell?.querySelector('[data-saved-resume-note]');
  const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]));
  const read = () => readSavedResumeState(window.localStorage);
  const snapshotDelta = (item) => {
    const entries = item?.snapshot?.entries;
    if (!Array.isArray(entries) || entries.length === 0) return null;
    const current = new Map(catalog.map((vehicle) => [vehicle.id, vehicle.fingerprint]));
    let changed = 0;
    let removed = 0;
    entries.forEach(({ id, fingerprint }) => {
      if (!current.has(id)) removed += 1;
      else if (current.get(id) !== fingerprint) changed += 1;
    });
    return { changed, removed };
  };
  const deltaLabel = (item) => {
    const delta = snapshotDelta(item);
    if (!delta || (!delta.changed && !delta.removed)) return '';
    const parts = [];
    if (delta.changed) parts.push(`判断材料の変更 ${delta.changed}件`);
    if (delta.removed) parts.push(`掲載終了・非公開 ${delta.removed}件`);
    return `<small class="saved-resume-delta" data-saved-resume-delta>${escapeHtml(parts.join(' / '))}</small>`;
  };
  const render = () => {
    const state = read();
    if (!shell || !actions) return state;
    if (!state || (!state.search && !state.compare)) { shell.hidden = true; actions.innerHTML = ''; return state; }
    shell.hidden = false;
    actions.innerHTML = ['search', 'compare'].filter((kind) => state[kind]).map((kind) => {
      const item = state[kind];
      const title = kind === 'search' ? '検索条件' : '比較';
      return `<span class="saved-resume-item"><span>${title}: ${escapeHtml(item.label)}${deltaLabel(item)}</span><a class="button small alt" href="${escapeHtml(item.href)}" data-saved-resume-open="${kind}">再開</a><button class="button small text" type="button" data-saved-resume-delete="${kind}">削除</button></span>`;
    }).join('');
    actions.querySelectorAll('[data-saved-resume-delete]').forEach((button) => button.addEventListener('click', () => {
      if (!deleteSavedResume(window.localStorage, button.dataset.savedResumeDelete) && note) note.textContent = 'このブラウザでは保存を利用できません。';
      render();
    }));
    return state;
  };
  window.jidouuntenSave = (kind, href, label, snapshot) => {
    const ok = updateSavedResume(window.localStorage, kind, href, label, new Date().toISOString(), snapshot);
    if (!ok) {
      if (note) note.textContent = '保存できません。URLをブックマークして続きから再開できます。';
      if (actions) actions.innerHTML = '';
      shell?.removeAttribute('hidden');
      return false;
    }
    render();
    return ok;
  };
  window.jidouuntenSavedResumeRender = render;
  render();
</script>
