---
import type { Vehicle } from '../data/loader';
import { availabilityLabels, canonicalRoadType, capabilityDefinition, displayIntroducedAt, handsOffLabels, levelLabels, monitoringLabels, vehicleReferenceLabel } from '../data/loader';
const { vehicle, selectable = false, checked = false } = Astro.props as { vehicle: Vehicle; selectable?: boolean; checked?: boolean };
const capabilityPriority = ['hands_off_highway', 'lane_change_support', 'traffic_jam_pilot', 'traffic_jam_assist', 'driver_monitoring', 'adaptive_cruise_control', 'lane_centering'];
const visibleCapabilities = [...vehicle.capabilities]
  .sort((a, b) => capabilityPriority.indexOf(a) - capabilityPriority.indexOf(b))
  .slice(0, 3)
  .map(capabilityDefinition);
---
<article class="vehicle-card">
  <div class="vehicle-card-body">
    <div class:list={['vehicle-level-tag', vehicle.automationLevel >= 3 ? 'is-automated' : 'is-assistance']}>LEVEL {vehicle.automationLevel}<span>{levelLabels[vehicle.automationLevel]}</span></div>
    <h3><a href={`/cars/${vehicle.id}/`}>{vehicle.maker} {vehicle.model}</a></h3>
    <div class="maker">{vehicleReferenceLabel(vehicle)}　{vehicle.grade}</div>
    <div class="meta">
      <span class:list={['pill', vehicle.availability === 'new_order_available' && 'lime']}>{availabilityLabels[vehicle.availability]}</span>
      <span class="pill">{handsOffLabels[vehicle.handsOff]}</span>
    </div>
    <div class="capability-chips" aria-label="確認できた主な機能">
      {visibleCapabilities.map((capability) => <span>{capability.label}</span>)}
    </div>
    <div class="card-specs">
      <span><strong>時期</strong> {displayIntroducedAt(vehicle.salesUnitIntroducedAt)}</span>
      <span><strong>道路</strong> {vehicle.odd.roadTypes.map(canonicalRoadType).filter((road, index, list) => list.indexOf(road) === index).join(' / ') || '不明'}</span>
      <span><strong>監視</strong> {monitoringLabels[vehicle.driverMonitoring]}</span>
    </div>
  </div>
  <div class="card-foot">
    <div class="card-actions">
      <a class="button small text" href={`/cars/${vehicle.id}/`}>詳細を見る <span aria-hidden="true">→</span></a>
      {selectable && <label class="check-card compare-check"><input type="checkbox" name="ids" value={vehicle.id} checked={checked} aria-label={`${vehicle.maker} ${vehicle.model}を比較に追加`} /> 比較に追加</label>}
    </div>
  </div>
</article>
