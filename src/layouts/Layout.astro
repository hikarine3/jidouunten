---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
const { title = '自動運転.jp｜同じLevel 2でも、できることは違う。', description = '日本向けの運転支援車を、自動化レベル、ハンズオフ、機能、発売・導入時期から探して比較できます。' } = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://jidouunten.jp').toString();
const socialImage = 'https://jidouunten.jp/og.png';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': canonical,
  url: canonical,
  name: title,
  description,
  isPartOf: { '@type': 'WebSite', '@id': 'https://jidouunten.jp/#website', url: 'https://jidouunten.jp', name: '自動運転.jp' },
};
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="自動運転.jp" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="同じLevel 2でも、できることは違う。日本向けの運転支援車を機能と条件で比較する自動運転.jp" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href="/" aria-label="自動運転.jp トップ"><span class="brand-mark" aria-hidden="true"></span>自動運転.jp</a>
        <nav aria-label="メインナビゲーション">
          <a href="/levels/">レベルを知る</a>
          <a href="/">車を探す</a>
          <a href="/compare/">比較する</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="footer">
      <div class="wrap footer-inner">
        <div><a class="footer-brand" href="/">自動運転.jp</a><span>日本向けの運転支援車を、機能と条件で比較。</span></div>
        <nav aria-label="フッターナビゲーション"><a href="/">車を探す</a><a href="/levels/">レベルの定義</a><a href="/compare/">比較する</a><a href="/privacy/">プライバシー</a></nav>
        <a class="footer-copy" href="https://1stclass.co.jp/">© {new Date().getFullYear()} 1st Class</a>
      </div>
    </footer>
    <Analytics />
  </body>
</html>
